[
 {
  "name": "per_occupied_room_night_branch_ignores_revenue_and_binds_the_period_cap",
  "grounds": [
   "calculations.assessment_amount.PER_OCCUPIED_ROOM_NIGHT_branch",
   "calculations.assessment_amount.constants.PER_NIGHT_RATE_CENTS",
   "calculations.assessment_amount.constants.CLASS_MULTIPLIER",
   "calculations.assessment_amount.constants.PERIOD_CAP_CENTS"
  ],
  "setup": [
   "logical clock 2026-08-01T00:00:00Z",
   "district Cove Reach on PER_OCCUPIED_ROOM_NIGHT, ACTIVE, three assessable properties summing to 100,000,000 of prior-year revenue",
   "period FY2027-Q1 generated, so every statement snapshots assessment_method_at_period_start PER_OCCUPIED_ROOM_NIGHT"
  ],
  "setup_api_calls": [
   "@A1",
   {
    "call": "POST /districts",
    "payload": {
     "name": "Cove Reach Tourism Improvement District",
     "assessment_method": "PER_OCCUPIED_ROOM_NIGHT",
     "included_zones": [
      "ZONE_CORE",
      "ZONE_PERIMETER"
     ],
     "term_years": 1,
     "current_fiscal_year": 2027
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01",
    "captures": {
     "d2_id": "$.data.id"
    }
   },
   {
    "call": "POST /lodging-businesses",
    "payload": {
     "district_id": "${d2_id}",
     "legal_name": "Cove Reach Grand",
     "boundary_zone": "ZONE_CORE",
     "classification": "FULL_SERVICE",
     "room_count": 400,
     "prior_year_gross_room_revenue_cents": 60000000,
     "operator_contact_email": "ops@covereachgrand.example"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01",
    "captures": {
     "c2b1_id": "$.data.id"
    }
   },
   {
    "call": "POST /lodging-businesses",
    "payload": {
     "district_id": "${d2_id}",
     "legal_name": "Cove Reach Boutique",
     "boundary_zone": "ZONE_PERIMETER",
     "classification": "BOUTIQUE",
     "room_count": 60,
     "prior_year_gross_room_revenue_cents": 15000000,
     "operator_contact_email": "ops@covereachboutique.example"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01",
    "captures": {
     "c2b2_id": "$.data.id"
    }
   },
   {
    "call": "POST /lodging-businesses",
    "payload": {
     "district_id": "${d2_id}",
     "legal_name": "Cove Reach Inn",
     "boundary_zone": "ZONE_CORE",
     "classification": "LIMITED_SERVICE",
     "room_count": 100,
     "prior_year_gross_room_revenue_cents": 25000000,
     "operator_contact_email": "ops@covereachinn.example"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01",
    "captures": {
     "c2b3_id": "$.data.id"
    }
   },
   {
    "call": "POST /petition-drives",
    "payload": {
     "district_id": "${d2_id}",
     "drive_type": "FORMATION",
     "closes_at": "2026-09-01T00:00:00Z"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01",
    "captures": {
     "pd2_id": "$.data.id"
    }
   },
   {
    "call": "POST /petition-drives/${pd2_id}/signatures",
    "payload": {
     "lodging_business_id": "${c2b1_id}"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01"
   },
   {
    "call": "POST /petition-drives/${pd2_id}/tally",
    "payload": {},
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01"
   },
   {
    "call": "POST /petition-drives/${pd2_id}/certification",
    "payload": {
     "certified_on": "2026-08-01T00:00:00Z"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01"
   },
   {
    "call": "POST /districts/${d2_id}/lifecycle-advances",
    "payload": {
     "to_status": "ACTIVE",
     "effective_on": "2026-08-01T00:00:00Z"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01"
   },
   {
    "call": "POST /assessment-periods",
    "payload": {
     "district_id": "${d2_id}",
     "period_label": "FY2027-Q1",
     "period_start": "2026-08-01T00:00:00Z",
     "period_end": "2026-11-01T00:00:00Z",
     "due_date": "2026-11-15T00:00:00Z",
     "grace_days": 10
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01",
    "captures": {
     "ap2_id": "$.data.id"
    }
   },
   {
    "call": "POST /assessment-periods/${ap2_id}/statement-generation",
    "payload": {},
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01"
   },
   {
    "call": "GET /assessment-periods/${ap2_id}/statements",
    "payload": {
     "lodging_business_id": "${c2b1_id}"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01",
    "captures": {
     "c2st1_id": "$.data[0].id"
    }
   },
   {
    "call": "GET /assessment-periods/${ap2_id}/statements",
    "payload": {
     "lodging_business_id": "${c2b2_id}"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01",
    "captures": {
     "c2st2_id": "$.data[0].id"
    }
   },
   {
    "call": "GET /assessment-periods/${ap2_id}/statements",
    "payload": {
     "lodging_business_id": "${c2b3_id}"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01",
    "captures": {
     "c2st3_id": "$.data[0].id"
    }
   }
  ],
  "trigger": [
   {
    "call": "POST /assessment-statements/${c2st1_id}/filings",
    "payload": {
     "reported_room_nights": 10000,
     "reported_gross_room_revenue_cents": 60000000
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01"
   },
   {
    "call": "POST /assessment-statements/${c2st2_id}/filings",
    "payload": {
     "reported_room_nights": 700,
     "reported_gross_room_revenue_cents": 15000000
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01"
   },
   {
    "call": "POST /assessment-statements/${c2st3_id}/filings",
    "payload": {
     "reported_room_nights": 1000,
     "reported_gross_room_revenue_cents": 25000000
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01"
   }
  ],
  "assert": [
   "all three responses have status 201",
   "AssessmentStatement.${c2st1_id}.assessment_method_at_period_start == PER_OCCUPIED_ROOM_NIGHT",
   "AssessmentStatement.${c2st1_id}.provisional_assessment_cents == 2500000, the PERIOD_CAP_CENTS ceiling, not the 3000000 gross",
   "AssessmentStatement.${c2st1_id}.effective_assessment_cents == 2500000 and total_due_cents == 2500000",
   "AssessmentStatement.${c2st2_id}.provisional_assessment_cents == 189000",
   "AssessmentStatement.${c2st3_id}.provisional_assessment_cents == 255000",
   "no statement of this district equals 2 percent of its reported revenue, so the PCT_OF_ROOM_REVENUE branch was not taken"
  ]
 },
