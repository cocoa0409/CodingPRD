    "captures": {
     "wp_v_approved": "$.data.version"
    }
   },
   {
    "call": "POST /marketing-programs",
    "payload": {
     "annual_work_plan_id": "${wp_id}",
     "name": "Autumn Group Sales Push",
     "channel": "GROUP_SALES",
     "committed_cents": 62000,
     "lodging_tax_matched_cents": 0,
     "booking_window_start": "2026-09-01T00:00:00Z",
     "booking_window_end": "2026-12-01T00:00:00Z"
    },
    "as": "DmoLiaison",
    "as_user_id": "dmo-01",
    "captures": {
     "mp_id": "$.data.id"
    }
   }
  ],
  "assert": [
   "the first program creation returns 409 with data.error_id == ERR_WORK_PLAN_NOT_APPROVED",
   "AnnualWorkPlan.${wp_id}.committed_program_cents == 0 after the refusal",
   "GET /annual-work-plans/${wp_id}/marketing-programs returns 0 rows after the refusal",
   "the approval returns 200 and AnnualWorkPlan.${wp_id}.status == APPROVED with funding_ratio 1.1645",
   "the identical program creation then returns 201 with MarketingProgram.${mp_id}.status == PLANNED",
   "AnnualWorkPlan.${wp_id}.committed_program_cents == 62000"
  ]
 },
 {
  "name": "notice_exactly_fourteen_days_ahead_is_accepted_and_thirteen_is_not",
  "grounds": [
   "validations.p75_minimum_public_notice",
   "errors[ERR_MEETING_NOTICE_TOO_LATE]",
   "state_machines.TransparencyRecord.SCHEDULED_to_NOTICED"
  ],
  "setup": [
   "canonical district ACTIVE, logical clock 2026-08-01T00:00:00Z",
   "an ANNUAL_REPORT record scheduled_for 2026-08-15 and a PUBLIC_MEETING record scheduled_for 2026-08-14"
  ],
  "setup_api_calls": [
   "@A1",
   "@A2",
   "@A3",
   "@A4",
   "@A5",
   "@A6",
   "@A7",
   "@A8",
   "@A9",
   "@A10",
   "@A11",
   {
    "call": "POST /transparency-records",
    "payload": {
     "district_id": "${d_id}",
     "record_type": "ANNUAL_REPORT",
     "fiscal_year": 2027,
     "scheduled_for": "2026-08-15T00:00:00Z",
     "required_by": "2026-09-30T00:00:00Z"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01",
    "captures": {
     "rec_report_id": "$.data.id"
    }
   },
   {
    "call": "POST /transparency-records",
    "payload": {
     "district_id": "${d_id}",
     "record_type": "PUBLIC_MEETING",
     "fiscal_year": 2027,
     "scheduled_for": "2026-08-14T00:00:00Z",
     "required_by": "2026-09-30T00:00:00Z"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01",
    "captures": {
     "rec_meeting_id": "$.data.id"
    }
   }
  ],
  "trigger": [
   {
    "call": "POST /transparency-records/${rec_meeting_id}/advance",
    "payload": {
     "to_status": "NOTICED"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01"
   },
   {
    "call": "POST /transparency-records/${rec_report_id}/advance",
    "payload": {
     "to_status": "NOTICED"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01"
   }
  ],
  "assert": [
   "the 13-day notice returns 409 with data.error_id == ERR_MEETING_NOTICE_TOO_LATE",
   "TransparencyRecord.${rec_meeting_id}.status is still SCHEDULED and noticed_on == null",
   "the 14-day notice returns 200 with TransparencyRecord.${rec_report_id}.status == NOTICED",
   "TransparencyRecord.${rec_report_id}.noticed_on == 2026-08-01T00:00:00Z",
   "District.${d_id}.transparency_standing == COMPLIANT throughout"
  ]
 },
