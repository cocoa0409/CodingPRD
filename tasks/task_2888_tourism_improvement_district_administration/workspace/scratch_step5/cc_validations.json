[
 {
  "name": "a_second_signature_from_the_same_business_is_refused_as_a_duplicate",
  "grounds": [
   "validations.p80_one_valid_signature_per_drive_and_business",
   "errors[ERR_DUPLICATE_SIGNATURE]",
   "calculations.petition_support"
  ],
  "setup": [
   "canonical district PROPOSED with the four-property roll",
   "FORMATION drive OPEN in [2026-08-01, 2026-09-01), b1 has signed once"
  ],
  "setup_api_calls": [
   "@A1",
   "@A2",
   "@A3",
   "@A4",
   "@A5",
   "@A6",
   "@A7",
   "@A8"
  ],
  "trigger": [
   {
    "call": "POST /petition-drives/${pd_id}/signatures",
    "payload": {
     "lodging_business_id": "${b1_id}"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01"
   }
  ],
  "assert": [
   "the response status is 409 with data.error_id == ERR_DUPLICATE_SIGNATURE",
   "PetitionDrive.${pd_id}.valid_signature_count == 1",
   "PetitionDrive.${pd_id}.signed_basis_cents == 60000000",
   "PetitionDrive.${pd_id}.weighted_support_pct == 0.6000",
   "GET /petition-drives/${pd_id}/signatures returns exactly one row"
  ]
 },
 {
  "name": "a_withdrawn_dispute_frees_its_type_slot_while_the_other_type_was_never_blocked",
  "grounds": [
   "validations.p80_one_non_terminal_dispute_per_statement_and_type",
   "errors[ERR_DISPUTE_ALREADY_OPEN]",
   "state_machines.AssessmentDispute.SUBMITTED_to_WITHDRAWN",
   "endpoints.POST_/assessment-disputes"
  ],
  "setup": [
   "district ACTIVE, st1 filed at 824,500",
   "one CALCULATION_ERROR dispute on st1 sitting in SUBMITTED (review deliberately not opened, so WITHDRAW stays legal)"
  ],
  "setup_api_calls": [
   "@A1",
   "@A2",
   "@A3",
   "@A4",
   "@A5",
   "@A6",
   "@A7",
   "@A8",
   "@A9",
   "@A10",
   "@A11",
   "@A12",
   "@A13",
   "@A14",
   "@A15",
   "@A28"
  ],
  "trigger": [
   {
    "call": "POST /assessment-disputes",
    "payload": {
     "assessment_statement_id": "${st1_id}",
     "dispute_type": "CALCULATION_ERROR",
     "claimed_adjustment_cents": 50000,
     "dispute_note": "same ground filed twice"
    },
    "as": "LodgingOperator",
    "as_user_id": "${b1_id}"
   },
   {
    "call": "POST /assessment-disputes",
    "payload": {
     "assessment_statement_id": "${st1_id}",
     "dispute_type": "EXEMPT_PROPERTY",
     "claimed_adjustment_cents": 824500,
     "dispute_note": "the annex wing is a nonprofit retreat"
    },
    "as": "LodgingOperator",
    "as_user_id": "${b1_id}",
    "captures": {
     "dsp_exempt_id": "$.data.id"
    }
   },
   {
    "call": "POST /assessment-disputes/${dsp1_id}/proceedings",
    "payload": {
     "action": "WITHDRAW",
     "note": "operator will refile with the corrected ledger"
    },
    "as": "LodgingOperator",
    "as_user_id": "${b1_id}"
   },
   {
    "call": "POST /assessment-disputes",
    "payload": {
     "assessment_statement_id": "${st1_id}",
     "dispute_type": "CALCULATION_ERROR",
     "claimed_adjustment_cents": 50000,
     "dispute_note": "refiled on the corrected ledger"
    },
    "as": "LodgingOperator",
    "as_user_id": "${b1_id}",
    "captures": {
     "dsp1_again_id": "$.data.id"
    }
   }
  ],
  "assert": [
   "the second CALCULATION_ERROR filing returns 409 with data.error_id == ERR_DISPUTE_ALREADY_OPEN",
   "the EXEMPT_PROPERTY filing returns 201 even though a CALCULATION_ERROR dispute is open on the same statement, because the slot key includes dispute_type",
   "AssessmentDispute.${dsp_exempt_id}.status == SUBMITTED with version == 1 and lodging_business_id == ${b1_id} and claimed_adjustment_cents == 824500",
   "the withdrawal returns 200 and AssessmentDispute.${dsp1_id}.status == WITHDRAWN",
   "the refiled CALCULATION_ERROR dispute returns 201 and ${dsp1_again_id} != ${dsp1_id}",
   "AssessmentDispute.${dsp1_again_id}.status == SUBMITTED with version == 1, appeal_count == 0 and info_request_count == 0",
   "GET /assessment-disputes?dispute_type=CALCULATION_ERROR returns both the WITHDRAWN ${dsp1_id} and the SUBMITTED ${dsp1_again_id}, so the withdrawn row was retained rather than deleted",
   "AssessmentStatement.${st1_id}.effective_assessment_cents is still 824500 and AssessmentStatement.${st1_id}.payment_status is still UNPAID, because filing or withdrawing a dispute never touches the money"
  ]
 },
 {
  "name": "statement_filing_priority_ladder_returns_401_403_403_400_then_404",
  "grounds": [
   "validations.p10_authentication",
   "validations.p20_role_authorisation",
   "validations.p25_operator_identity_resolves",
   "validations.p30_input_shape",
   "validations.p40_existence"
  ],
  "setup": [
   "canonical district ACTIVE with period FY2027-Q1 generated, st1 belongs to b1"
  ],
  "setup_api_calls": [
   "@A1",
   "@A2",
   "@A3",
   "@A4",
   "@A5",
   "@A6",
   "@A7",
   "@A8",
   "@A9",
   "@A10",
   "@A11",
   "@A12",
   "@A13",
   "@A14"
  ],
  "trigger": [
   {
    "call": "POST /assessment-statements/00000000-0000-0000-0000-0000000000ff/filings",
    "payload": {
     "reported_room_nights": 2000
    },
    "as": "NONE \u2014 the X-User-Role and X-User-ID headers are both omitted",
    "as_user_id": "NONE"
   },
   {
    "call": "POST /assessment-statements/00000000-0000-0000-0000-0000000000ff/filings",
    "payload": {
     "reported_room_nights": 2000
    },
    "as": "BoardMember",
    "as_user_id": "board-member-01"
   },
   {
    "call": "POST /assessment-statements/00000000-0000-0000-0000-0000000000ff/filings",
    "payload": {
     "reported_room_nights": 2000
    },
    "as": "LodgingOperator",
    "as_user_id": "00000000-0000-0000-0000-0000000000aa"
   },
   {
    "call": "POST /assessment-statements/00000000-0000-0000-0000-0000000000ff/filings",
    "payload": {
     "reported_room_nights": 2000
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01"
   },
   {
    "call": "POST /assessment-statements/00000000-0000-0000-0000-0000000000ff/filings",
    "payload": {
     "reported_room_nights": 2000,
     "reported_gross_room_revenue_cents": 41225000
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01"
   }
  ],
  "assert": [
   "call 1 returns 401 with data.error_id == ERR_UNAUTHENTICATED",
   "call 2 returns 403 with data.error_id == ERR_FORBIDDEN_ROLE, because BoardMember is not in this endpoint's roles",
   "call 3 returns 403 with data.error_id == ERR_OPERATOR_IDENTITY_UNKNOWN, decided before the missing field and before the path id",
   "call 4 returns 400 with data.error_id == ERR_INVALID_REQUEST for the missing reported_gross_room_revenue_cents",
   "call 5 returns 404 with data.error_id == ERR_ASSESSMENT_STATEMENT_NOT_FOUND",
   "AssessmentStatement.${st1_id}.filing_status is still NOT_FILED, since none of the five calls touched a real statement"
  ]
 },
 {
