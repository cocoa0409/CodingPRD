scenario: 'Railcar Manufacturing & Lease Fleet Conversion (Trinity Industries): order backlog management across car types with production line configuration and changeover planning, component supply for wheelsets, castings and coatings with lead times exceeding order-to-delivery windows, lease fleet decisions where manufactured cars are retained for leasing rather than sold with capital allocation implications, lease structures across full-service and net leases with maintenance responsibility differences, regulatory retrofit requirements driving fleet modification programs with shop capacity scheduling, car assignment to lessees with per-diem, mileage and utilization accounting, secondary market sales of lease fleet cars with portfolio management, scrapping decisions at end of regulatory life'
domain_name: railcar-manufacturing-lease-fleet-conversion
api_prefix: /api/v1
response_envelope:
  success: "{ \"meta\": { \"api_request_id\": \"req_xxx\", \"api_request_timestamp\": \"ISO8601\" },\n  \"response_type\": \"object\" | \"array\", \"data\": {} }\n"
  error: "{ \"meta\": { ... }, \"response_type\": \"error\",\n  \"data\": { \"error_id\": \"ERR_XXX\", \"message\": \"...\" } }\n"
  pagination_fields:
  - limit
  - offset
  - total_count
  - has_more
  pagination_defaults:
    limit: 10
    min: 1
    max: 100
    offset: 0
complexity_profile:
  primary_archetype: quota_allocation
  secondary_archetype: ledger_reconciliation
  complexity_layers:
  - optimistic_concurrency
  - cascading_side_effects
  - dual_variant_calculation
  - derived_field_reconciliation
  entity_topology: graph
  state_machine_shape: cyclic
  relationship_patterns:
  - one_to_many
  - many_to_many
  - self_referential
  - cross_aggregate
  role_model: segregation_of_duties
  consistency_model: immediate
entities:
- name: CarType
  parent: null
  common_fields: true
  fields:
  - name: model_code
    type: string
    source: input
    description: Manufacturer model code; unique across CarType.
    constraints: unique
  - name: car_class
    type: enum
    source: input
    description: Physical class of the car.
    constraints: 'enum: BOXCAR | TANK | HOPPER | FLATCARS | GONDOLA'
  - name: build_hours
    type: integer
    source: input
    description: Standard shop hours to build one car of this type; >= 1.
    constraints: '>= 1'
  - name: regulatory_life_years
    type: integer
    source: input
    description: Regulatory service life in years from built_date; >= 10.
    constraints: '>= 10'
  - name: line_count_family
    type: string
    source: input
    description: Production line family this car type runs on; a line may build several types in the same family.
  - name: status
    type: enum
    source: computed
    description: ACTIVE while the type is offered in the catalogue; RETIRED once retired.
    constraints: 'enum: ACTIVE | RETIRED'
    default: ACTIVE
- name: Component
  parent: null
  common_fields: true
  fields:
  - name: part_number
    type: string
    source: input
    description: Supplier part number; unique across Component.
    constraints: unique
  - name: component_class
    type: enum
    source: input
    description: Procurement family of the part.
    constraints: 'enum: WHEELSET | CASTING | COATING'
  - name: unit_cost_cents
    type: integer
    source: input
    description: Standard cost of one unit, in cents; >= 0.
    constraints: '>= 0'
  - name: lead_time_days
    type: integer
    source: input
    description: Supplier lead time in days from order to receipt; >= 0.
    constraints: '>= 0'
  - name: on_hand_qty
    type: integer
    source: system
    description: Units physically on hand and uncommitted; system-maintained, defaults to 0 at creation. Increased only by receipt, decreased only by consumption or scrapping.
    constraints: '>= 0'
    default: 0
  - name: reserved_qty
    type: integer
    source: computed
    description: Units committed to released ProductionOrders or to IN_PROGRESS RetrofitPrograms (per §1.3 component_allocation).
    default: 0
- name: CarTypeComponentRequirement
  parent: null
  common_fields: true
  fields:
  - name: car_type_id
    type: string
    source: input
    description: FK -> CarType.id; junction side referencing the car type.
  - name: component_id
    type: string
    source: input
    description: FK -> Component.id; junction side referencing the component.
  - name: qty_per_car
    type: integer
    source: input
    description: Units of this component consumed per finished car; >= 1.
    constraints: '>= 1'
- name: ProductionOrder
  parent: null
  common_fields: true
  fields:
  - name: car_type_id
    type: string
    source: input
    description: FK -> CarType.id; the car type this order builds.
  - name: quantity
    type: integer
    source: input
    description: Cars ordered; >= 1.
    constraints: '>= 1'
  - name: completed_qty
    type: integer
    description: Cars finished so far for this order.
    default: 0
  - name: unit_price_cents
    type: integer
    source: input
    description: Contracted price per car, in cents; >= 0.
    constraints: '>= 0'
  - name: planned_shop_days
    type: integer
    source: input
    description: Shop days reserved on the production line for this order; >= 1 and must equal car_type.build_hours * quantity.
    constraints: '>= 1; must equal CarType.build_hours * quantity'
  - name: disposition
    type: enum
    source: input
    description: Whether finished cars are sold to the lessee customer or retained in the lease fleet.
    constraints: 'enum: SOLD | RETAINED'
  - name: priority_rank
    type: integer
    source: input
    description: Backlog priority; lower value schedules first; >= 1.
    constraints: '>= 1'
  - name: order_date
    type: string
    source: input
    description: ISO 8601 date the order was taken; drives the lead-time feasibility check.
  - name: required_delivery_date
    type: string
    source: input
    description: ISO 8601 date the cars must be delivered to the customer.
  - name: status
    type: enum
    source: computed
    description: Backlog lifecycle state; see state_machines.ProductionOrder.
    constraints: 'enum: DRAFT | COMPONENT_RESERVED | RELEASED | IN_PRODUCTION | COMPLETED | CANCELLED'
    default: DRAFT
  - name: supersedes_production_order_id
    type: string
    source: input
    description: FK -> ProductionOrder.id; set when this order was created by superseding a CANCELLED endorsement order. Null for an original order.
  - name: retention_reason
    type: string
    source: input
    description: Reason recorded when the order is released with disposition RETAINED.
- name: SubstitutionEndorsement
  parent: null
  common_fields: true
  fields:
  - name: production_order_id
    type: string
    source: input
    description: FK -> ProductionOrder.id; the order awaiting the endorsement.
  - name: original_component_id
    type: string
    source: input
    description: FK -> Component.id; the component the order is short of.
  - name: substitute_component_id
    type: string
    source: input
    description: FK -> Component.id; the component offered in its place.
  - name: substitute_qty_per_car
    type: integer
    source: input
    description: Units of the substitute consumed per car; >= 1. Overrides the junction row quantity while the endorsement is APPROVED.
    constraints: '>= 1'
  - name: status
    type: enum
    source: computed
    description: Endorsement lifecycle state; see state_machines.SubstitutionEndorsement.
    constraints: 'enum: PENDING | APPROVED | APPLIED | REJECTED | SUPERSEDED'
    default: PENDING
  - name: decides_material
    type: boolean
    source: input
    description: True when this endorsement can change the material composition of a car (component_class differs from the original); such endorsements are material in flight.
- name: LeaseContract
  parent: null
  common_fields: true
  fields:
  - name: lessee_id
    type: string
    source: input
    description: FK -> Lessee.id; the party leasing the cars.
  - name: lease_type
    type: enum
    source: input
    description: Full-service leases bundle maintenance into the rate; net leases do not.
    constraints: 'enum: FULL_SERVICE | NET'
  - name: per_diem_rate_cents
    type: integer
    source: input
    description: Daily rate per car, in cents; >= 0. On FULL_SERVICE contracts the rate includes maintenance.
    constraints: '>= 0'
  - name: liability_bearer
    type: enum
    source: input
    description: Who pays for maintenance and regulatory retrofit on cars under this contract.
    constraints: 'enum: LESSOR | LESSEE'
  - name: term_start_date
    type: string
    source: input
    description: ISO 8601 date the contract term opens.
  - name: term_end_date
    type: string
    source: input
    description: ISO 8601 date the contract term closes; must be after term_start_date.
  - name: status
    type: enum
    source: computed
    description: Contract lifecycle state; see state_machines.LeaseContract.
    constraints: 'enum: DRAFT | ACTIVE | AMENDMENT_DRAFTED | TERMINATED | EXPIRED'
    default: DRAFT
  - name: amendment_seq
    type: integer
    source: computed
    description: Number of amendments ratified on this contract; starts at 0 and increments per ratify.
    default: 0
  - name: capital_allocation_cents
    type: integer
    description: Capital moved to the lease fleet for RETAINED cars under this contract, evaluated by §1.3 lease_fleet_capital_allocation.
    default: 0
- name: Lessee
  parent: null
  common_fields: true
  fields:
  - name: legal_name
    type: string
    source: input
    description: Legal entity name; unique across Lessee.
    constraints: unique
  - name: credit_tier
    type: enum
    source: input
    description: Credit standing; A is the strongest.
    constraints: 'enum: A | B | C | D'
  - name: utilization_threshold_pct
    type: integer
    source: input
    description: Utilization percent at or above which the lessee qualifies for the full per-diem credit under §1.3 mileage_true_up_settlement; 0..100.
    constraints: 0..100
  - name: outstanding_balance_cents
    type: integer
    description: 'Ledger balance owed by the lessee: sum of settled net charges minus payments.'
    default: 0
  - name: status
    type: enum
    source: computed
    description: Standing of the lessee account.
    constraints: 'enum: ACTIVE | SUSPENDED | CLOSED'
    default: ACTIVE
- name: LeaseFleetCar
  parent: null
  common_fields: true
  fields:
  - name: car_type_id
    type: string
    source: input
    description: FK -> CarType.id; the type this car was built as.
  - name: production_order_id
    type: string
    source: input
    description: FK -> ProductionOrder.id; the order that produced this car. Set when a RETAINED order completes; null for a car acquired on the secondary market.
  - name: lease_contract_id
    type: string
    source: input
    description: FK -> LeaseContract.id; the contract the car is currently written under; null while unassigned.
  - name: acquisition_cost_cents
    type: integer
    source: input
    description: Capitalized cost of the car when it entered the fleet, in cents; >= 0.
    constraints: '>= 0'
  - name: accumulated_mileage
    type: integer
    source: computed
    description: Total miles recorded across every CarAssignment and CarReturn for this car.
    default: 0
  - name: status
    type: enum
    source: computed
    description: Fleet lifecycle state; see state_machines.LeaseFleetCar.
    constraints: 'enum: HELD | ASSIGNED | UNDER_REPAIR | SOLD | SCRAPPED'
    default: HELD
  - name: built_date
    type: string
    source: input
    description: ISO 8601 date the car was built (or re-built for a secondary-market acquisition).
  - name: regulatory_life_end_date
    type: string
    source: computed
    description: built_date + car_type.regulatory_life_years; after this date the car may only be scrapped.
  - name: retrofit_required
    type: boolean
    source: computed
    description: True while the car is enrolled in a RetrofitProgram whose status is IN_PROGRESS and whose compliance_deadline_date is not yet past.
    default: false
- name: CarAssignment
  parent: null
  common_fields: true
  fields:
  - name: lease_fleet_car_id
    type: string
    source: input
    description: FK -> LeaseFleetCar.id; the car being placed with a lessee.
  - name: lease_contract_id
    type: string
    source: input
    description: FK -> LeaseContract.id; the contract governing this placement.
  - name: start_date
    type: string
    source: input
    description: ISO 8601 date the placement opens.
  - name: end_date
    type: string
    source: input
    description: ISO 8601 date the placement closes; exclusive — the car is free from this date onward.
  - name: per_diem_rate_cents
    type: integer
    source: computed
    description: Rate snapshotted from the contract at placement time, in cents.
  - name: mileage_allowance
    type: integer
    source: input
    description: Included miles per month for this placement; >= 0.
    constraints: '>= 0'
  - name: mileage_used
    type: integer
    source: computed
    description: Miles recorded so far on this placement.
    default: 0
  - name: per_diem_accrued_cents
    type: integer
    description: Per-diem accrued to date, evaluated by §1.3 assignment_per_diem_accrual.
    default: 0
  - name: mileage_charge_cents
    type: integer
    description: Mileage true-up accrued to date, evaluated by §1.3 mileage_true_up_settlement.
    default: 0
  - name: maintenance_cost_cents
    type: integer
    description: Maintenance burden attributed to this placement; full amount when the contract liability_bearer is LESSOR, zero when LESSEE.
    default: 0
  - name: status
    type: enum
    source: computed
    description: Placement lifecycle state; see state_machines.CarAssignment.
    constraints: 'enum: ACTIVE | SUSPENDED | REASSIGNED | COMPLETED'
    default: ACTIVE
- name: CarReturn
  parent: null
  common_fields: true
  fields:
  - name: lease_fleet_car_id
    type: string
    source: input
    description: FK -> LeaseFleetCar.id; the car being returned.
  - name: car_assignment_id
    type: string
    source: input
    description: FK -> CarAssignment.id; the placement being closed.
  - name: return_date
    type: string
    source: input
    description: ISO 8601 date the car came back to the fleet.
  - name: mileage_since_last
    type: integer
    source: input
    description: Miles the car ran on this placement; >= 0.
    constraints: '>= 0'
  - name: condition_grade
    type: enum
    source: input
    description: Physical condition at return.
    constraints: 'enum: A | B | C | D'
  - name: maintenance_parts_cents
    type: integer
    source: computed
    description: Parts cost at return, derived from condition_grade via CONDITION_PARTS_CENTS.
    default: 0
  - name: mileage_overage_cents
    type: integer
    description: Mileage true-up charged at return, evaluated by §1.3 mileage_true_up_settlement.
    default: 0
  - name: settlement_status
    type: enum
    source: computed
    description: Billing state of the return.
    constraints: 'enum: PENDING | SETTLED'
    default: PENDING
- name: RetrofitProgram
  parent: null
  common_fields: true
  fields:
  - name: mandate_code
    type: string
    source: input
    description: Regulatory mandate identifier; unique across RetrofitProgram.
    constraints: unique
  - name: description
    type: string
    source: input
    description: What the mandate requires of enrolled cars.
  - name: compliance_deadline_date
    type: string
    source: input
    description: ISO 8601 date by which every enrolled car must be retrofitted.
  - name: required_shop_days_per_car
    type: integer
    source: input
    description: Shop days needed to retrofit one car; >= 1.
    constraints: '>= 1'
  - name: required_component_id
    type: string
    source: input
    description: FK -> Component.id; the coating or casting kit consumed per retrofit car; null when the mandate consumes no component.
  - name: program_cost_cents
    type: integer
    description: Total capitalized program cost, evaluated by §1.3 retrofit_program_cost_allocation.
    default: 0
  - name: status
    type: enum
    source: computed
    description: Program lifecycle state; see state_machines.RetrofitProgram.
    constraints: 'enum: PLANNED | IN_PROGRESS | COMPLETED | VOIDED'
    default: PLANNED
- name: RetrofitProgramCarType
  parent: null
  common_fields: true
  fields:
  - name: retrofit_program_id
    type: string
    source: input
    description: FK -> RetrofitProgram.id; junction side referencing the program.
  - name: car_type_id
    type: string
    source: input
    description: FK -> CarType.id; junction side referencing the covered car type.
- name: RetrofitWorkOrder
  parent: null
  common_fields: true
  fields:
  - name: retrofit_program_id
    type: string
    source: input
    description: FK -> RetrofitProgram.id; the mandate this work satisfies.
  - name: lease_fleet_car_id
    type: string
    source: input
    description: FK -> LeaseFleetCar.id; the car being retrofitted.
  - name: shop_line
    type: string
    source: input
    description: Shop line the work occupies; unique per closed date interval.
  - name: scheduled_start_date
    type: string
    source: input
    description: ISO 8601 date the retrofit work begins.
  - name: scheduled_end_date
    type: string
    source: input
    description: ISO 8601 date the retrofit work ends; exclusive.
  - name: shop_days
    type: integer
    source: computed
    description: Days the work occupies its shop line = scheduled_end_date - scheduled_start_date; must equal retrofit_program.required_shop_days_per_car.
  - name: component_qty_consumed
    type: integer
    source: input
    description: Units of retrofit_program.required_component_id consumed by this work order; >= 1.
    constraints: '>= 1'
  - name: status
    type: enum
    source: computed
    description: Work-order lifecycle state; see state_machines.RetrofitWorkOrder.
    constraints: 'enum: SCHEDULED | IN_PROGRESS | COMPLETED | CANCELLED'
    default: SCHEDULED
- name: ComponentPurchaseOrder
  parent: null
  common_fields: true
  fields:
  - name: component_id
    type: string
    source: input
    description: FK -> Component.id; the part being bought.
  - name: qty_ordered
    type: integer
    source: input
    description: Units ordered; >= 1.
    constraints: '>= 1'
  - name: unit_cost_cents
    type: integer
    source: input
    description: Agreed price per unit for this purchase, in cents; >= 0.
    constraints: '>= 0'
  - name: order_date
    type: string
    source: input
    description: ISO 8601 date the purchase was placed.
  - name: expected_receipt_date
    type: string
    source: input
    description: ISO 8601 date the units are expected; must equal order_date plus the component's supplier lead time when derived.
  - name: status
    type: enum
    source: computed
    description: Purchase lifecycle state; see state_machines.ComponentPurchaseOrder.
    constraints: 'enum: PLACED | CONFIRMED | RECEIVED | CANCELLED'
    default: PLACED
- name: ComponentReceipt
  parent: null
  common_fields: true
  fields:
  - name: component_purchase_order_id
    type: string
    source: input
    description: FK -> ComponentPurchaseOrder.id; the purchase being received.
  - name: component_id
    type: string
    source: input
    description: FK -> Component.id; the part received.
  - name: qty_received
    type: integer
    source: input
    description: Units physically received; >= 1.
    constraints: '>= 1'
  - name: receipt_date
    type: string
    source: input
    description: ISO 8601 date of receipt.
- name: LeaseFleetSale
  parent: null
  common_fields: true
  fields:
  - name: lease_fleet_car_id
    type: string
    source: input
    description: FK -> LeaseFleetCar.id; the car being sold.
  - name: lease_contract_id
    type: string
    source: input
    description: FK -> LeaseContract.id; the contract that had to be terminated before the sale; null when the car was unassigned.
  - name: buyer_name
    type: string
    source: input
    description: Name of the secondary-market buyer.
  - name: sale_price_cents
    type: integer
    source: input
    description: Gross sale price, in cents; >= 0.
    constraints: '>= 0'
  - name: net_book_value_cents
    type: integer
    source: input
    description: Carrying value used for the gain or loss computation, in cents; >= 0.
    constraints: '>= 0'
  - name: writeback_liability_cents
    type: integer
    source: input
    description: Accrued maintenance liability written back to the lessee on a net-lease sale; >= 0.
    constraints: '>= 0'
  - name: sale_date
    type: string
    source: input
    description: ISO 8601 date of sale.
  - name: status
    type: enum
    source: computed
    description: Sale lifecycle state; see state_machines.LeaseFleetSale.
    constraints: 'enum: PENDING_SETTLEMENT | SETTLED | VOIDED'
    default: PENDING_SETTLEMENT
  - name: gain_loss_cents
    type: integer
    description: Realized gain (positive) or loss (negative), evaluated by §1.3 sale_gain_loss.
    default: 0
state_machines:
- entity: ProductionOrder
  initial_state: DRAFT
  terminal_states:
  - COMPLETED
  - CANCELLED
  transitions:
  - from: DRAFT
    to: COMPONENT_RESERVED
    trigger: POST /production-orders/{id}/reserve-components
    actor: ProductionPlanner
    preconditions:
    - production_order.status == DRAFT
    - For every CarTypeComponentRequirement row of the order's car_type, and for every component_class in {WHEELSET, CASTING}, Component.on_hand_qty >= qty_per_car * production_order.quantity
    - The component_class COATING requirement is exempt from the on-hand test and is instead covered by §1.4 catalog row for purchase-order lead time
    side_effects:
    - Sets production_order.status = COMPONENT_RESERVED
    - For each covered CarTypeComponentRequirement row, decrements Component.on_hand_qty by qty_per_car * quantity and recomputes Component.reserved_qty per §1.3 component_allocation
    - Recomputes production_order.unit_price_cents per §1.3 order_price_quote
    - Increments production_order.version by 1 and refreshes updated_at
    note: Only WHEELSET and CASTING rows commit stock here; COATING is procured to contract and commits on the purchase-receipt path instead.
  - from: COMPONENT_RESERVED
    to: RELEASED
    trigger: POST /production-orders/{id}/release
    actor: ProductionPlanner
    preconditions:
    - production_order.status == COMPONENT_RESERVED
    - 'Every CarTypeComponentRequirement row of the order''s car_type has committed supply: for WHEELSET and CASTING the committed stock released at reservation, for COATING a ComponentPurchaseOrder exists for that component with status CONFIRMED or RECEIVED and expected_receipt_date <= production_order.required_delivery_date'
    - No other ProductionOrder on the same CarType.line_count_family has status IN_PRODUCTION with a higher-priority backlog position that would be preempted
    side_effects:
    - Sets production_order.status = RELEASED
    - When production_order.disposition == RETAINED, recomputes LeaseContract.capital_allocation_cents for the contract named in the release body per §1.3 lease_fleet_capital_allocation
    - Increments production_order.version by 1 and refreshes updated_at
  - from: RELEASED
    to: IN_PRODUCTION
    trigger: POST /production-lines/{line}/changeover
    actor: ProductionPlanner
    preconditions:
    - production_order.status == RELEASED
    - 'production_order is the head of the backlog schedule for its CarType.line_count_family: lowest priority_rank, tie-broken by earliest order_date, then earliest created_at'
    - The changeover window [scheduled_start, scheduled_end) does not collide with any other changeover on the same line per §1.4
    side_effects:
    - Sets production_order.status = IN_PRODUCTION
    - Sets production_order.planned_shop_days as the width of the changeover window, which must equal car_type.build_hours * quantity
    - Increments production_order.version by 1 and refreshes updated_at
  - from: IN_PRODUCTION
    to: COMPLETED
    trigger: POST /production-orders/{id}/complete
    actor: ProductionPlanner
    preconditions:
    - production_order.status == IN_PRODUCTION
    - 'Body completes the remaining cars in one step: completed_qty + delta_qty == quantity'
    side_effects:
    - Sets production_order.completed_qty = quantity and status = COMPLETED
    - When disposition == SOLD, debits Lessee.outstanding_balance_cents by unit_price_cents * quantity for the lessee named on the order, defaulting to the only LESSOR-liable contract in ACTIVE status when the body omits lessee_id
    - When disposition == RETAINED, creates one LeaseFleetCar per car with status HELD, production_order_id = production_order.id, acquisition_cost_cents = unit_price_cents, built_date = the completion date, and recomputes its regulatory_life_end_date and retrofit_required
    - 'Compensating path for the RETAINED branch: creating 3 LeaseFleetCars while 3 cars remain in the RETAINED backlog would push the fleet''s retained-car count above the contract''s retained_car_limit; the 3rd car is therefore created with status SCRAPPED instead of HELD, and the order still reports COMPLETED with completed_qty == quantity'
    - Increments production_order.version by 1 and refreshes updated_at
  - from: DRAFT
    to: CANCELLED
    trigger: POST /production-orders/{id}/cancel
    actor: ProductionPlanner
    preconditions:
    - production_order.status in {DRAFT, COMPONENT_RESERVED}
    side_effects:
    - Sets production_order.status = CANCELLED
    - When the prior status was COMPONENT_RESERVED, restores Component.on_hand_qty for every covered row and leaves Component.reserved_qty unchanged
    - Increments production_order.version by 1 and refreshes updated_at
  - from: COMPONENT_RESERVED
    to: CANCELLED
    trigger: POST /production-orders/{id}/cancel
    actor: ProductionPlanner
    preconditions:
    - production_order.status == COMPONENT_RESERVED
    side_effects:
    - Sets production_order.status = CANCELLED
    - Restores Component.on_hand_qty for every covered CarTypeComponentRequirement row and leaves Component.reserved_qty unchanged
    - For every SubstitutionEndorsement of this order with status in {PENDING, APPROVED, APPLIED}, sets its status to SUPERSEDED
    - Increments production_order.version by 1 and refreshes updated_at
- entity: SubstitutionEndorsement
  initial_state: PENDING
  terminal_states:
  - APPLIED
  - REJECTED
  - SUPERSEDED
  transitions:
  - from: PENDING
    to: APPROVED
    trigger: POST /substitution-endorsements/{id}/approve
    actor: LeaseAdministrator
    preconditions:
    - substitution_endorsement.status == PENDING
    - The acting X-User-ID is not the X-User-ID that created the endorsement
    side_effects:
    - Sets substitution_endorsement.status = APPROVED
    - Recomputes production_order.unit_price_cents per §1.3 order_price_quote using the endorsed substitute in place of the original component
    - Increments substitution_endorsement.version by 1 and refreshes updated_at
  - from: PENDING
    to: APPROVED
    trigger: POST /production-orders/{id}/reserve-components
    actor: system
    preconditions:
    - A SubstitutionEndorsement exists for this order with status PENDING and original_component_id equal to the short component
    - 'Substitute component stock test passes: Component.on_hand_qty of the substitute >= substitute_qty_per_car * production_order.quantity'
    side_effects:
    - Sets substitution_endorsement.status = APPROVED
    - The reservation commits the substitute's stock instead of the original's for the endorsed requirement row
    note: Automatic endorsement applied at reservation time when the substitute is in stock; the manual approve path is the operator's alternative.
  - from: APPROVED
    to: APPLIED
    trigger: POST /production-orders/{id}/release
    actor: ProductionPlanner
    preconditions:
    - substitution_endorsement.status == APPROVED
    - Any SubstitutionEndorsement on the same production_order with status APPROVED and decides_material == true must also be APPLIED in the same request, or the release fails
    side_effects:
    - Sets substitution_endorsement.status = APPLIED
    - Replaces the original component's committed stock with the substitute's for the endorsed CarTypeComponentRequirement row and recomputes Component.reserved_qty for both components per §1.3 component_allocation
    - Recomputes production_order.unit_price_cents per §1.3 order_price_quote
  - from: PENDING
    to: REJECTED
    trigger: PATCH /substitution-endorsements/{id}
    actor: LeaseAdministrator
    preconditions:
    - substitution_endorsement.status == PENDING
    side_effects:
    - Sets substitution_endorsement.status = REJECTED
    - Increments substitution_endorsement.version by 1 and refreshes updated_at
  - from: REJECTED
    to: PENDING
    trigger: PATCH /substitution-endorsements/{id}
    actor: ProductionPlanner
    preconditions:
    - substitution_endorsement.status == REJECTED
    - The endorsement has not been rejected twice before; the third rejection is terminal and the PATCH fails
    side_effects:
    - Sets substitution_endorsement.status = PENDING
    - Clears any substitution.committeed_qty on the production order
    - Increments substitution_endorsement.version by 1 and refreshes updated_at
    note: 'Cycle: PENDING -> REJECTED -> PENDING -> REJECTED is allowed once; the second return to PENDING is the last retry.'
- entity: LeaseContract
  initial_state: DRAFT
  terminal_states:
  - TERMINATED
  - EXPIRED
  transitions:
  - from: DRAFT
    to: ACTIVE
    trigger: POST /lease-contracts/{id}/activate
    actor: LeaseAdministrator
    preconditions:
    - lease_contract.status == DRAFT
    - lease_contract.term_end_date > the logical clock's current date
    - No CarAssignment referencing this contract has overlapping date intervals per §1.4
    side_effects:
    - Sets lease_contract.status = ACTIVE
    - Increments lease_contract.version by 1 and refreshes updated_at
  - from: ACTIVE
    to: AMENDMENT_DRAFTED
    trigger: POST /lease-contracts/{id}/amendments
    actor: LeaseAdministrator
    preconditions:
    - lease_contract.status == ACTIVE
    - expected_lease_version equals lease_contract.version
    side_effects:
    - Sets lease_contract.status = AMENDMENT_DRAFTED
    - Stores the drafted per_diem_rate_cents and liability_bearer on the contract draft
    - Increments lease_contract.version by 1 and refreshes updated_at
  - from: AMENDMENT_DRAFTED
    to: ACTIVE
    trigger: POST /lease-contracts/{id}/amendments/ratify
    actor: LeaseAdministrator
    preconditions:
    - lease_contract.status == AMENDMENT_DRAFTED
    - expected_lease_version equals lease_contract.version
    side_effects:
    - Sets lease_contract.status = ACTIVE and increments lease_contract.amendment_seq by 1
    - Refreshes per_diem_rate_cents on every CarAssignment referencing this contract whose status is ACTIVE, and recomputes each assignment's per_diem_accrued_cents per §1.3 assignment_per_diem_accrual
    - Recomputes maintenance_cost_cents on every CarAssignment of this contract per §1.3 maintenance_burden_allocation under the newly ratified liability_bearer
    - Increments lease_contract.version by 1 and refreshes updated_at
    note: 'Cycle: ACTIVE -> AMENDMENT_DRAFTED -> ACTIVE forms the contract revision loop.'
  - from: ACTIVE
    to: TERMINATED
    trigger: POST /lease-contracts/{id}/terminate
    actor: LeaseAdministrator
    preconditions:
    - lease_contract.status == ACTIVE
    - No CarAssignment referencing this contract has status in {ACTIVE, SUSPENDED} unless the body lists every such assignment in cascade_assignment_ids
    side_effects:
    - Sets lease_contract.status = TERMINATED
    - For each CarAssignment of this contract with status in {ACTIVE, SUSPENDED}, sets status = COMPLETED and sets the parent LeaseFleetCar.status = HELD
    - When previous_status was RELEASED and owed_to? is false, leaves Lessee.outstanding_balance_cents unchanged; the settled net charge is accrued instead
    - Increments lease_contract.version by 1 and refreshes updated_at
- entity: CarAssignment
  initial_state: ACTIVE
  terminal_states:
  - COMPLETED
  transitions:
  - from: ACTIVE
    to: SUSPENDED
    trigger: POST /car-assignments/{id}/suspend
    actor: LeaseAdministrator
    preconditions:
    - car_assignment.status == ACTIVE
    - The parent LeaseFleetCar.status == ASSIGNED
    - The governing LeaseContract.status == ACTIVE
    side_effects:
    - Sets car_assignment.status = SUSPENDED and stops per-diem accrual
    - Sets the parent LeaseFleetCar.status = HELD
    - Recomputes the assignment's per_diem_accrued_cents as of the suspension date per §1.3 assignment_per_diem_accrual
    - Increments car_assignment.version by 1 and refreshes updated_at
  - from: SUSPENDED
    to: ACTIVE
    trigger: POST /car-assignments/{id}/resume
    actor: LeaseAdministrator
    preconditions:
    - car_assignment.status == SUSPENDED
    - The governing LeaseContract.status == ACTIVE
    - The parent LeaseFleetCar.status == HELD
    side_effects:
    - Sets car_assignment.status = ACTIVE and restarts per-diem accrual
    - Sets the parent LeaseFleetCar.status = ASSIGNED
    - Increments car_assignment.version by 1 and refreshes updated_at
    note: 'Cycle: ACTIVE -> SUSPENDED -> ACTIVE forms the placement pause loop.'
  - from: ACTIVE
    to: REASSIGNED
    trigger: POST /car-assignments/{id}/reassign
    actor: LeaseAdministrator
    preconditions:
    - car_assignment.status == ACTIVE
    - The target car has status HELD and its lease_contract_id equals the source car's lease_contract_id
    side_effects:
    - Sets car_assignment.status = REASSIGNED
    - Creates a replacement CarAssignment on the target car with start_date = end_date of this assignment and per_diem_rate_cents snapshotted from the same contract
    - Increments car_assignment.version by 1 and refreshes updated_at
  - from: REASSIGNED
    to: ACTIVE
    trigger: POST /car-assignments/{id}/resume
    actor: LeaseAdministrator
    preconditions:
    - car_assignment.status == REASSIGNED
    - The governing LeaseContract.status == ACTIVE
    - The parent LeaseFleetCar.status == HELD
    side_effects:
    - Sets car_assignment.status = ACTIVE
    - Sets the parent LeaseFleetCar.status = ASSIGNED
    - Increments car_assignment.version by 1 and refreshes updated_at
    note: 'Cycle: ACTIVE -> REASSIGNED -> ACTIVE means a placement may move to another car and come back.'
  - from: ACTIVE
    to: COMPLETED
    trigger: POST /car-returns
    actor: LeaseAdministrator
    preconditions:
    - car_assignment.status in {ACTIVE, SUSPENDED}
    - car_returns.return_date > car_assignment.start_date
    - No other CarAssignment on the same LeaseFleetCar has a date interval that would overlap the closed interval per §1.4
    side_effects:
    - Sets car_assignment.status = COMPLETED
    - Sets the parent LeaseFleetCar.status = UNDER_REPAIR and recomputes its accumulated_mileage and retrofit_required
    - Recomputes the return's mileage_overage_cents per §1.3 mileage_true_up_settlement
    - Recomputes Lessee.outstanding_balance_cents per §1.3 mileage_true_up_settlement
    - Increments car_assignment.version by 1 and refreshes updated_at
- entity: LeaseFleetCar
  initial_state: HELD
  terminal_states:
  - SOLD
  - SCRAPPED
  transitions:
  - from: HELD
    to: ASSIGNED
    trigger: POST /car-assignments
    actor: LeaseAdministrator
    preconditions:
    - lease_fleet_car.status == HELD
    - The target LeaseContract.status == ACTIVE
    - The car is not enrolled in any RetrofitProgram whose status == IN_PROGRESS
    side_effects:
    - Sets lease_fleet_car.status = ASSIGNED
    - Sets lease_fleet_car.lease_contract_id to the contract named on the assignment
    note: Reached through the assignment-creation endpoint; there is no separate activate endpoint.
  - from: UNDER_REPAIR
    to: HELD
    trigger: POST /lease-fleet-cars/{id}/settle-returns
    actor: ProductionPlanner
    preconditions:
    - lease_fleet_car.status == UNDER_REPAIR
    - Every CarReturn of this car has settlement_status == SETTLED
    side_effects:
    - Sets lease_fleet_car.status = HELD and clears lease_contract_id
    - Recomputes lease_fleet_car.retrofit_required
    - Increments lease_fleet_car.version by 1 and refreshes updated_at
  - from: HELD
    to: UNDER_REPAIR
    trigger: POST /retrofit-work-orders
    actor: ProductionPlanner
    preconditions:
    - lease_fleet_car.status == HELD
    - The car's CarType is covered by the retrofits program via RetrofitProgramCarType
    - The car is not enrolled in any RetrofitProgram whose status == IN_PROGRESS
    - The alternative entry is the RegulatoryRetrofitist schedule endpoint, which admits a car whose owing_to? flag is false
    side_effects:
    - Sets lease_fleet_car.status = UNDER_REPAIR
    - Sets lease_fleet_car.retrofit_required = true
    - Increments lease_fleet_car.version by 1 and refreshes updated_at
    note: SubstitutionEndorsement decisions are the alternative route into this transition when the endorsement was created by a RegulatoryRetrofitist.
  - from: UNDER_REPAIR
    to: HELD
    trigger: POST /retrofit-work-orders/{id}/complete
    actor: ProductionPlanner
    preconditions:
    - lease_fleet_car.status == UNDER_REPAIR
    - The work order's shop window is not past retrofit_program.compliance_deadline_date
    side_effects:
    - Sets lease_fleet_car.status = HELD
    - Sets lease_fleet_car.built_date to the completion date and recomputes regulatory_life_end_date
    - Recomputes retrofit_program.program_cost_cents per §1.3 retrofit_program_cost_allocation
    - Increments lease_fleet_car.version by 1 and refreshes updated_at
  - from: HELD
    to: SOLD
    trigger: POST /lease-fleet-sales
    actor: PortfolioManager
    preconditions:
    - lease_fleet_car.status == HELD
    - lease_fleet_car.regulatory_life_end_date > the sale date
    side_effects:
    - Sets lease_fleet_car.status = SOLD and clears lease_fleet_car.lease_contract_id
    - Computes lease_fleet_sales.net_book_value_cents, writeback_liability_cents and gain_loss_cents per §1.3 sale_gain_loss
    - Increments lease_fleet_car.version by 1 and refreshes updated_at
  - from: HELD
    to: SCRAPPED
    trigger: POST /lease-fleet-cars/{id}/scrap
    actor: PortfolioManager
    preconditions:
    - lease_fleet_car.status == HELD
    side_effects:
    - Sets lease_fleet_car.status = SCRAPPED
    - Recomputes lease_contract.capital_allocation_cents for its former contract per §1.3 lease_fleet_capital_allocation
    - Deletes this car's RetrofitWorkOrder rows whose status == SCHEDULED and sets the others to CANCELLED
    - Increments lease_fleet_car.version by 1 and refreshes updated_at
  - from: SOLD
    to: HELD
    trigger: POST /lease-fleet-sales/{id}/void
    actor: PortfolioManager
    preconditions:
    - lease_fleet_sale.status == PENDING_SETTLEMENT
    side_effects:
    - Sets lease_fleet_sale.status = VOIDED and lease_fleet_car.status = HELD
    - Reverses the gain or loss previously recorded for this sale
    - Increments lease_fleet_sale.version by 1 and refreshes updated_at
    note: Compensating action; it must leave PortfolioLedger.realized_gain_cents exactly where it stood before the sale settled.
- entity: RetrofitProgram
  initial_state: PLANNED
  terminal_states:
  - COMPLETED
  - VOIDED
  transitions:
  - from: PLANNED
    to: IN_PROGRESS
    trigger: POST /retrofit-programs/{id}/start
    actor: RegulatoryRetrofitist
    preconditions:
    - retrofit_program.status == PLANNED
    - The program has at least one RetrofitProgramCarType row
    side_effects:
    - Sets retrofit_program.status = IN_PROGRESS
    - Sets retrofit_required = true on every LeaseFleetCar of a covered CarType whose status in {HELD, UNDER_REPAIR}
    - Recomputes retrofit_program.program_cost_cents per §1.3 retrofit_program_cost_allocation
    - Increments retrofit_program.version by 1 and refreshes updated_at
  - from: IN_PROGRESS
    to: COMPLETED
    trigger: POST /retrofit-programs/{id}/complete
    actor: RegulatoryRetrofitist
    preconditions:
    - retrofit_program.status == IN_PROGRESS
    - Every RetrofitProgramCarType of the program has at least one RetrofitWorkOrder with status == COMPLETED
    - All RetrofitWorkOrder rows of this program are in status COMPLETED or CANCELLED
    side_effects:
    - Sets retrofit_program.status = COMPLETED
    - Sets retrofit_required = false on every LeaseFleetCar of a covered CarType
    - Increments retrofit_program.version by 1 and refreshes updated_at
  - from: IN_PROGRESS
    to: VOIDED
    trigger: POST /retrofit-programs/{id}/void
    actor: RegulatoryRetrofitist
    preconditions:
    - retrofit_program.status == IN_PROGRESS
    side_effects:
    - Sets retrofit_program.status = VOIDED
    - Sets status = CANCELLED on every RetrofitWorkOrder of this program and sets retrofit_required = false on every enrolled LeaseFleetCar
    - Increments retrofit_program.version by 1 and refreshes updated_at
- entity: RetrofitWorkOrder
  initial_state: SCHEDULED
  terminal_states:
  - COMPLETED
  - CANCELLED
  transitions:
  - from: SCHEDULED
    to: IN_PROGRESS
    trigger: POST /retrofit-work-orders/{id}/start
    actor: ProductionPlanner
    preconditions:
    - retrofit_work_order.status == SCHEDULED
    - The work order's shop window [scheduled_start_date, scheduled_end_date) does not overlap any other work order's window on the same shop_line per §1.4
    - The parent LeaseFleetCar.status == UNDER_REPAIR
    side_effects:
    - Sets retrofit_work_order.status = IN_PROGRESS
    - Decrements Component.on_hand_qty by component_qty_consumed for retrofit_program.required_component_id when that component is set
    - Increments retrofit_work_order.version by 1 and refreshes updated_at
  - from: IN_PROGRESS
    to: COMPLETED
    trigger: POST /retrofit-work-orders/{id}/complete
    actor: ProductionPlanner
    preconditions:
    - retrofit_work_order.status == IN_PROGRESS
    side_effects:
    - Sets retrofit_work_order.status = COMPLETED
    - Returns the parent LeaseFleetCar to HELD and recomputes its regulatory_life_end_date
    - Recomputes retrofit_program.program_cost_cents per §1.3 retrofit_program_cost_allocation
    - Increments retrofit_work_order.version by 1 and refreshes updated_at
  - from: SCHEDULED
    to: CANCELLED
    trigger: POST /retrofit-work-orders/{id}/cancel
    actor: ProductionPlanner
    preconditions:
    - retrofit_work_order.status == SCHEDULED
    side_effects:
    - Sets retrofit_work_order.status = CANCELLED
    - Increments retrofit_work_order.version by 1 and refreshes updated_at
    - Recomputes RetrofitProgram.program_cost_cents per §1.3 retrofit_program_cost_allocation
- entity: ComponentPurchaseOrder
  initial_state: PLACED
  terminal_states:
  - RECEIVED
  - CANCELLED
  transitions:
  - from: PLACED
    to: CONFIRMED
    trigger: POST /component-purchase-orders/{id}/confirm
    actor: SupplyChainCoordinator
    preconditions:
    - component_purchase_order.status == PLACED
    side_effects:
    - Sets component_purchase_order.status = CONFIRMED
    - Increments component_purchase_order.version by 1 and refreshes updated_at
  - from: CONFIRMED
    to: RECEIVED
    trigger: POST /component-receipts/{id}/receive
    actor: SupplyChainCoordinator
    preconditions:
    - component_purchase_order.status == CONFIRMED
    - The linked ComponentReceipt.receipt_date is not before component_purchase_order.order_date
    side_effects:
    - Sets component_purchase_order.status = RECEIVED
    - Increases Component.on_hand_qty by ComponentReceipt.qty_received and recomputes Component.reserved_qty per §1.3 component_allocation
    - Increments component_purchase_order.version by 1 and refreshes updated_at
  - from: PLACED
    to: CANCELLED
    trigger: POST /component-purchase-orders/{id}/cancel
    actor: SupplyChainCoordinator
    preconditions:
    - component_purchase_order.status == PLACED
    side_effects:
    - Sets component_purchase_order.status = CANCELLED
    - Increments component_purchase_order.version by 1 and refreshes updated_at
- entity: LeaseFleetSale
  initial_state: PENDING_SETTLEMENT
  terminal_states:
  - SETTLED
  - VOIDED
  transitions:
  - from: PENDING_SETTLEMENT
    to: SETTLED
    trigger: POST /lease-fleet-sales/{id}/settle
    actor: PortfolioManager
    preconditions:
    - lease_fleet_sale.status == PENDING_SETTLEMENT
    - The lease contract of the sold car is TERMINATED or null
    side_effects:
    - Sets lease_fleet_sale.status = SETTLED
    - Adjusts PortfolioLedger.realized_gain_cents by lease_fleet_sales.gain_loss_cents
    - Credits Lessee.outstanding_balance_cents by writeback_liability_cents when the terminated contract's liability_bearer was LESSEE
    - Increments lease_fleet_sale.version by 1 and refreshes updated_at
  - from: PENDING_SETTLEMENT
    to: VOIDED
    trigger: POST /lease-fleet-sales/{id}/void
    actor: PortfolioManager
    preconditions:
    - lease_fleet_sale.status == PENDING_SETTLEMENT
    side_effects:
    - Sets lease_fleet_sale.status = VOIDED and restores the car to HELD
    - Leaves PortfolioLedger.realized_gain_cents exactly as it stood before this sale was created
    - Increments lease_fleet_sale.version by 1 and refreshes updated_at
- entity: PortfolioLedger
  initial_state: OPEN
  terminal_states: []
  transitions:
  - from: OPEN
    to: OPEN
    trigger: POST /lease-fleet-sales/{id}/settle
    actor: system
    preconditions:
    - The sale being settled has status PENDING_SETTLEMENT
    side_effects:
    - Increments PortfolioLedger.realized_gain_cents by the sale's gain_loss_cents
    - Recomputes PortfolioLedger.fleet_nbv_cents per §1.3 fleet_capital_reconciliation
    - Increments PortfolioLedger.version by 1 and refreshes updated_at
  - from: OPEN
    to: OPEN
    trigger: POST /production-orders/{id}/complete
    actor: system
    preconditions:
    - The completing order has disposition RETAINED
    side_effects:
    - Increases PortfolioLedger.committed_capital_cents by unit_price_cents * completed_qty
    - Recomputes PortfolioLedger.fleet_nbv_cents per §1.3 fleet_capital_reconciliation
    - Increments PortfolioLedger.version by 1 and refreshes updated_at
calculations:
- name: order_price_quote
  trigger: POST /production-orders; POST /production-orders/{id}/reserve-components; POST /substitution-endorsements/{id}/approve; POST /production-orders/{id}/release
  algorithm: tiered_pricing
  formula: "# COMMITTED variant (base). Rounded per-line-item, then summed (round order fixed).\nrows = CarTypeComponentRequirement where car_type_id == order.car_type_id\nfor each row r in rows, ordered by Component.part_number ASC, tie-broken by r.created_at ASC:\n    eff_qty(r)   = substitution_qty_per_car of the SubstitutionEndorsement on this order\n                   whose original_component_id == r.component_id and whose status IN {APPROVED, APPLIED}\n                   if one exists, else r.qty_per_car\n    line(r)      = ceil( (eff_qty(r) * component.unit_cost_cents + 25000) / 100 ) * 100\nCOMPONENT_SUBTOTAL = sum of line(r) over rows\nLABOR_CENTS        = car_type.build_hours * 45000\nUNROUNDED          = COMPONENT_SUBTOTAL + LABOR_CENTS\nFEE_CAP            = floor(UNROUNDED * 8 / 100)              # 8 percent of UNROUNDED\nRAW_FEE            = 15000 * count(SubstitutionEndorsement on this order with status IN {APPROVED, APPLIED})\nCHANGE_FEE         = min(RAW_FEE, FEE_CAP)\nunit_price_cents\
    \   = UNROUNDED + CHANGE_FEE\n"
  input_set: All CarTypeComponentRequirement rows of the order's car_type. Rows superseded by an APPROVED or APPLIED SubstitutionEndorsement use the substitute's quantity and cost; PENDING, REJECTED and SUPERSEDED endorsements are excluded from the substitution set. The fee term counts only APPROVED or APPLIED endorsements.
  constants:
    LINE_SURCHARGE_CENTS: 25000
    LABOR_RATE_CENTS_PER_BUILD_HOUR: 45000
    CHANGE_FEE_PER_ENDORSEMENT_CENTS: 15000
    FEE_CAP_PCT_OF_UNROUNDED: 8
  precision: integer cents; per-line ceil to the next whole dollar then sum, then integer floor for FEE_CAP
  variants:
  - name: committed
    when: The order has been component-reserved or released; contract prices and the endorsed composition are locked.
    difference: Base algorithm above.
  - name: forecast
    when: The order is still DRAFT and the logical clock's current date is more than the lock horizon past order_date.
    difference: "Two substitutions apply before the line loop:\n(1) For every row whose component_class IN {WHEELSET, CASTING} and where\n    current_date - order.order_date > 120 days, replace component.unit_cost_cents\n    with ceil(component.unit_cost_cents * 110 / 100) — the locked contract price has lapsed.\n(2) For every row whose component_class == COATING and where\n    component.lead_time_days > 60 days, replace component.unit_cost_cents with\n    ceil(component.unit_cost_cents * 104 / 100).\nThe resulting unit_price_cents is strictly greater than the committed variant whenever\nat least one row is affected.\n"
- name: lease_fleet_capital_allocation
  trigger: POST /production-orders/{id}/release; POST /production-orders/{id}/complete; POST /lease-fleet-cars/{id}/scrap
  algorithm: aggregation
  formula: "retained_cars = LeaseFleetCar c where c.production_order_id == order.id\n                and c.status IN {HELD, ASSIGNED, UNDER_REPAIR}\ncapital_cents = count(retained_cars) * order.unit_price_cents\n# written to LeaseContract.capital_allocation_cents for the contract named on the order\n# the discount applies inside the min() so evaluation order is pinned:\nfleet_share_bps    = 700                      # 7.00 percent of capital is retained as equity\nlessor_equity_cents= floor(capital_cents * min(fleet_share_bps, 900) / 10000)\n"
  input_set: LeaseFleetCar rows whose production_order_id points at this order and whose status is one of the three live fleet states. SOLD and SCRAPPED cars are excluded, so a scrap re-derives a smaller capital figure.
  constants:
    RETAINED_CAR_EQUITY_BPS: 700
    EQUITY_BPS_CEILING: 900
  precision: integer cents; floor at the end
  variants:
  - name: retained_basis
    when: production_order.disposition == RETAINED.
    difference: Capital accumulates on LeaseContract.capital_allocation_cents as cars complete into the fleet.
  - name: sold_basis
    when: production_order.disposition == SOLD.
    difference: 'Capital never enters the fleet: capital_allocation_cents keeps its prior value and the order value is instead accrued against Lessee.outstanding_balance_cents.'
- name: assignment_per_diem_accrual
  trigger: POST /car-assignments; POST /car-assignments/{id}/suspend; POST /car-returns; POST /lease-contracts/{id}/amendments/ratify
  algorithm: chronological
  formula: "# current_open variant (base)\nend   = if assignment.status IN {COMPLETED, REASSIGNED} then assignment.end_date\n        else the logical clock's current date\ndays  = end - assignment.start_date                    # end date exclusive\ngross = days * assignment.per_diem_rate_cents\nutil_pct = floor(assignment.mileage_used / 100)         # miles to utilization percent\ncredit = if lessee.utilization_threshold_pct <= util_pct then floor(gross * 12 / 100) else 0\nper_diem_accrued_cents = gross - credit\n"
  input_set: One CarAssignment. The credit term reads Lessee.utilization_threshold_pct of the contract's lessee; the rate reads the snapshot stored on the assignment, not the contract's current rate.
  constants:
    UTILIZATION_CREDIT_PCT: 12
    MILES_PER_UTILIZATION_POINT: 100
  precision: integer cents; floor for the credit
  variants:
  - name: current_open
    when: Evaluated on an open placement while it is ACTIVE or SUSPENDED.
    difference: Base algorithm above; the accrual window ends at the current logical clock date.
  - name: restated_chronological
    when: Evaluated after a contract amendment, a reassignment, or a return.
    difference: 'Walk every CarAssignment of the same LeaseFleetCar in start_date ASC order,

      tie-broken by created_at ASC, clipping each interval to

      [contract.term_start_date, contract.term_end_date) and to

      [current_date - 365 days, current_date). Sum days across the clipped intervals

      and multiply once by the snapshotted rate — a restated figure that differs from

      current_open whenever a placement was suspended, reassigned, or clipped by a term bound.

      '
- name: mileage_true_up_settlement
  trigger: POST /car-returns; POST /car-assignments/{id}/suspend
  algorithm: threshold
  formula: 'days_in_placement = assignment.end_date - assignment.start_date

    blocks            = ceil(days_in_placement / 30)

    included_miles    = blocks * assignment.mileage_allowance

    overage_miles     = max(0, assignment.mileage_used - included_miles)

    amount_cents      = overage_miles * 12

    '
  input_set: One CarAssignment at return time. The allowance is the assignment's own mileage_allowance, not the contract's. An overage of exactly 0 produces a charge of exactly 0.
  constants:
    MILEAGE_OVERAGE_RATE_CENTS: 12
    DAYS_PER_ALLOWANCE_BLOCK: 30
  precision: integer cents
  variants:
  - name: monthly_prorated
    when: The placement ran for one or more whole allowance blocks.
    difference: Base algorithm above; allowance is re-granted per 30-day block.
  - name: term_trailing
    when: The governing contract is a NET lease whose term is shorter than the placement.
    difference: 'included_miles = assignment.mileage_allowance (granted once for the whole term, not per block).

      amount_cents is therefore strictly greater than monthly_prorated whenever

      days_in_placement > 30 and mileage_used > mileage_allowance.

      '
- name: maintenance_burden_allocation
  trigger: POST /car-returns; POST /lease-contracts/{id}/amendments/ratify; POST /lease-fleet-sales/{id}/settle
  algorithm: waterfall_allocation
  formula: "total_parts_cents = CONDITION_PARTS_CENTS[car_return.condition_grade]\nif contract.liability_bearer == LESSOR:\n    lessor_share_cents = total_parts_cents\nelse:\n    lessor_share_cents = floor(total_parts_cents * min(lessee_parts_share_pct, 5) / 100)\nlessee_share_cents = total_parts_cents - lessor_share_cents\n# CarAssignment.maintenance_cost_cents stores lessor_share_cents\n"
  input_set: One CarAssignment, its governing LeaseContract and the CarReturn condition grade. The lessee share percentage is capped inside min() so the split is well-defined before the subtraction.
  constants:
    CONDITION_PARTS_CENTS:
      A: 0
      B: 200000
      C: 400000
      D: 600000
    LESSEE_PARTS_SHARE_PCT: 1
    LESSEE_PARTS_SHARE_PCT_CEILING: 5
  precision: integer cents; floor for the lessor share, remainder to the lessee
  variants:
  - name: lessor_liable
    when: contract.liability_bearer == LESSOR.
    difference: The lessor absorbs the entire parts cost; the lessee share is 0.
  - name: lessee_liable
    when: contract.liability_bearer == LESSEE.
    difference: The lessee absorbs total minus the capped lessor share; the split differs from lessor_liable for every non-zero parts cost.
- name: component_allocation
  trigger: POST /production-orders/{id}/reserve-components; POST /production-orders/{id}/release; POST /production-orders/{id}/cancel; POST /component-receipts/{id}/receive; POST /retrofit-work-orders/{id}/start
  algorithm: constraint_propagation
  formula: "# Evaluation order is pinned: on_hand_qty is authoritative and read first;\n# reserved_qty is then re-derived from scratch (never incrementally patched).\nreservations = sum over CarTypeComponentRequirement r where r.component_id == component.id of\n                 r.qty_per_car * sum(quantity of ProductionOrder o\n                                     where o.car_type_id == r.car_type_id\n                                     and o.status == RELEASED)\nretrofit_holds = sum over RetrofitWorkOrder w where w.status == IN_PROGRESS and\n                   w.retrofit_program.required_component_id == component.id\n                   of w.component_qty_consumed\nreserved_qty = reservations + retrofit_holds\nshortfall_qty = if reserved_qty > on_hand_qty then reserved_qty - on_hand_qty else 0\n"
  input_set: One Component. Only ProductionOrder rows in status RELEASED contribute reservations (DRAFT, COMPONENT_RESERVED, COMPLETED and CANCELLED do not). Only RetrofitWorkOrder rows in status IN_PROGRESS contribute retrofit holds (SCHEDULED, COMPLETED and CANCELLED do not).
  constants: {}
  precision: integer units
  variants:
  - name: committed_stock
    when: Derived at reservation and release time.
    difference: Base algorithm above.
  - name: available_to_promise
    when: Derived on a read after a receipt has landed.
    difference: Identical reservations term, but on_hand_qty has already been increased by ComponentReceipt.qty_received, so shortfall_qty is recomputed lower.
- name: production_feasibility_gate
  trigger: POST /production-orders; POST /production-orders/{id}/reserve-components
  algorithm: threshold
  formula: "horizon_days = order.required_delivery_date - order.order_date\ngated_rows   = CarTypeComponentRequirement r where r.car_type_id == order.car_type_id\n               and component.component_class IN {WHEELSET, CASTING}\nworst_lead   = max over gated_rows of ceil( component.lead_time_days / r.qty_per_car )\n# an order with zero gated_rows has worst_lead = 0 by convention\nfeasible     = horizon_days >= worst_lead\n"
  input_set: Only WHEELSET and CASTING requirement rows gate the order. COATING rows are excluded because coatings are procured to a service contract and never gate release.
  constants:
    GATED_COMPONENT_CLASSES:
    - WHEELSET
    - CASTING
  precision: whole days; ceil for the derived lead time
  variants:
  - name: lead_time_gate
    when: Evaluated when the order is created or component-reserved.
    difference: Base algorithm above.
- name: scrape_or_retrofit_decision
  trigger: POST /lease-fleet-cars/{id}/scrap; POST /retrofit-programs/{id}/start
  algorithm: threshold
  formula: "if current_clock_date > car.regulatory_life_end_date:\n    decision = SCRAP\nelse:\n    allowance_cents = 2500000\n    retrofit_cost_cents = program.required_shop_days_per_car * 185000\n                          + ( program.required_component.unit_cost_cents * w.component_qty_consumed\n                              if program.required_component_id is set else 0 )\n    if retrofit_cost_cents > allowance_cents:\n        decision = SCRAP\n    elif car.retrofit_required:\n        decision = RETROFIT\n    else:\n        decision = RETAIN\n"
  input_set: 'One LeaseFleetCar and the RetrofitProgram covering its car type. The life-end test is inclusive of the end date itself: a car whose regulatory_life_end_date equals the current clock date is still RETROFIT-eligible.'
  constants:
    RETROFIT_ALLOWANCE_CENTS: 2500000
    RETROFIT_SHOP_DAY_RATE_CENTS: 185000
  precision: integer cents
  variants:
  - name: life_expired
    when: current_clock_date > car.regulatory_life_end_date.
    difference: Forces SCRAP regardless of retrofit economics.
  - name: economic_scrap
    when: The car is inside its regulatory life but retrofit_cost_cents > allowance_cents.
    difference: Forces SCRAP on cost grounds while the car could still legally run.
- name: sale_gain_loss
  trigger: POST /lease-fleet-sales; POST /lease-fleet-sales/{id}/settle; POST /lease-fleet-sales/{id}/void
  algorithm: chronological
  formula: 'age_days        = sale.sale_date - car.built_date

    book_cents      = car.acquisition_cost_cents - age_days * 2500

    gain_loss_cents = sale.sale_price_cents - book_cents - sale.writeback_liability_cents

    balance_delta_cents = gain_loss_cents - sale.writeback_liability_cents

    '
  input_set: One LeaseFleetSale and its car. writeback_liability_cents is zero on a full-service sale and the accrued lessee liability on a net-lease sale.
  constants:
    DAILY_DEPRECIATION_CENTS: 2500
  precision: integer cents; no rounding step
  variants:
  - name: full_service_basis
    when: The car's terminated contract had lease_type == FULL_SERVICE.
    difference: writeback_liability_cents is 0, so gain_loss_cents equals sale_price_cents minus book_cents.
  - name: net_basis
    when: The car's terminated contract had lease_type == NET.
    difference: The accrued lessee liability is written back and subtracted, so gain_loss_cents is strictly lower by exactly writeback_liability_cents.
- name: fleet_capital_reconciliation
  trigger: POST /lease-fleet-sales/{id}/settle; POST /production-orders/{id}/complete
  algorithm: forward_looking
  formula: "# oldest_basis variant (base)\ndisposal_proceeds_net = sum of LeaseFleetSale.sale_price_cents where status == SETTLED, floored at 0\ncommitted_basis_cents  = PortfolioLedger.committed_capital_cents - disposal_proceeds_net\n# newest_basis variant\nfleet_nbv_cents = ceil( sum over LeaseFleetCar c with status IN {HELD, ASSIGNED, UNDER_REPAIR}\n                        of max(0, c.acquisition_cost_cents - (current_clock_date - c.built_date) * 2500) )\ndrift_cents = committed_basis_cents - fleet_nbv_cents\n"
  input_set: All LeaseFleetSale rows in status SETTLED (VOIDED and PENDING_SETTLEMENT rows are excluded). PortfolioLedger is a singleton row. Only live cars (HELD, ASSIGNED, UNDER_REPAIR) enter the newest basis.
  constants: {}
  precision: integer cents
  variants:
  - name: oldest_basis
    when: Capital is recomputed from the original commitment history on every ledger read.
    difference: Charges the full disposal proceeds against committed capital and applies no depreciation, so it keeps the historic cost basis.
  - name: newest_basis
    when: Capital is recomputed from the live fleet's depreciated book value.
    difference: Applies 2500 cents of depreciation per car per day, so the two bases diverge by exactly drift_cents once a car is sold.
- name: retrofit_program_cost_allocation
  trigger: POST /retrofit-work-orders/{id}/complete; POST /retrofit-programs/{id}/start
  algorithm: aggregation
  formula: "program_cost_cents = sum over RetrofitWorkOrder w of this program with w.status == COMPLETED of\n                       ( w.shop_days * 185000\n                         + w.component_qty_consumed * retrofit_program.required_component.unit_cost_cents )\n"
  input_set: Only RetrofitWorkOrder rows in status COMPLETED contribute (SCHEDULED, IN_PROGRESS and CANCELLED do not). A program with required_component_id null contributes only the shop-day term.
  constants:
    RETROFIT_SHOP_DAY_RATE_CENTS: 185000
  precision: integer cents
  variants:
  - name: scheduled_estimate
    when: Program is PLANNED or IN_PROGRESS.
    difference: Counts every work order not in CANCELLED status.
  - name: completed_actual
    when: Program is COMPLETED.
    difference: Counts only COMPLETED work orders, so a cancelled work order in the middle reduces the program cost.
- name: lessee_balance_reconciliation
  trigger: POST /car-returns; POST /lease-fleet-sales/{id}/settle; POST /production-orders/{id}/complete
  algorithm: aggregation
  formula: "outstanding_balance_cents =\n      sum(mileage_overage_cents of CarReturn rows of this lessee with settlement_status == SETTLED)\n    + sum(unit_price_cents * quantity of ProductionOrder rows of this lessee with status == COMPLETED\n          and disposition == SOLD)\n    + sum(writeback_liability_cents of LeaseFleetSale rows of this lessee with status == SETTLED)\n    - sum(unit_price_cents * retained_count of ProductionOrder rows of this lessee with disposition == RETAINED)\n# floored at zero\noutstanding_balance_cents = max(0, outstanding_balance_cents)\n"
  input_set: Accrues only SETTLED returns and SETTLED sales plus COMPLETED sold orders. RETAINED orders credit the balance back, so retaining instead of selling lowers the lessee's balance.
  constants: {}
  precision: integer cents; clamped at zero
  variants:
  - name: settled_accrual
    when: Derived on any write to a CarReturn, LeaseFleetSale or ProductionOrder.
    difference: Base algorithm above.
validations:
- priority: 1
  category: auth
  check: X-User-Role and X-User-ID headers are present and name a declared role
  error_id: ERR_UNAUTHENTICATED
  http_status: 401
  applies_to: all
- priority: 2
  category: auth
  check: The acting role is permitted for the operation by §1.7 and by the endpoint's roles list
  error_id: ERR_FORBIDDEN
  http_status: 403
  applies_to: all
- priority: 3
  category: existence
  check: Every path-templated resource id resolves to a persisted row, validated left to right in the path
  error_id: ERR_NOT_FOUND
  http_status: 404
  applies_to: all /{id} paths
- priority: 4
  category: existence
  check: 'Every foreign key named in the request body resolves: lease_fleet_car_id, lease_contract_id, lessee_id, component_id, car_type_id, production_order_id, retrofit_program_id'
  error_id: ERR_COMPONENT_NOT_FOUND
  http_status: 404
  applies_to: POST /production-orders; POST /car-assignments; POST /lease-contracts; POST /substitution-endorsements; POST /retrofit-work-orders; POST /component-purchase-orders
- priority: 5
  category: state
  check: The target resource is in a state from which the requested action is legal per §1.2
  error_id: ERR_INVALID_STATE
  http_status: 409
  applies_to: all action endpoints
- priority: 6
  category: state
  check: The target resource has not reached a terminal state; terminal resources accept no further transitions
  error_id: ERR_ALREADY_TERMINAL
  http_status: 409
  applies_to: POST /production-orders/{id}/complete; POST /lease-fleet-sales/{id}/settle; POST /retrofit-programs/{id}/start
- priority: 7
  category: state
  check: The supplied expected_*_version equals the parent's current version
  error_id: ERR_STALE_VERSION
  http_status: 412
  applies_to: POST /lease-contracts/{id}/amendments; POST /substitution-endorsements
- priority: 8
  category: business_safety
  check: The car's regulatory_life_end_date is greater than or equal to the operation date; a car at or past the end of its regulatory life may only be scrapped
  error_id: ERR_REGULATORY_LIFE_EXCEEDED
  http_status: 422
  applies_to: POST /lease-fleet-sales; POST /car-assignments; POST /retrofit-work-orders
- priority: 9
  category: business_safety
  check: Retrofit work is scheduled so its window ends on or before retrofit_program.compliance_deadline_date
  error_id: ERR_RETROFIT_DEADLINE_PASSED
  http_status: 422
  applies_to: POST /retrofit-work-orders; POST /retrofit-programs/{id}/start
- priority: 10
  category: business_temporal
  check: The requested retrofit shop window [scheduled_start_date, scheduled_end_date) collides with no other retrofit work order on the same shop_line; intervals are half-open so a window ending exactly when another starts is allowed
  error_id: ERR_SHOP_SLOT_OVERLAP
  http_status: 409
  applies_to: POST /retrofit-work-orders; POST /retrofit-work-orders/{id}/start
- priority: 11
  category: business_temporal
  check: The requested placement interval [start_date, end_date) collides with no other CarAssignment of the same LeaseFleetCar; a one-day buffer is required between placements, so a start_date equal to a prior end_date plus zero or one day is rejected
  error_id: ERR_ASSIGNMENT_OVERLAP
  http_status: 409
  applies_to: POST /car-assignments
- priority: 12
  category: business_temporal
  check: The requested changeover window [scheduled_start, scheduled_end) collides with no other changeover on the same CarType.line_count_family; the line is exclusive-occupancy and windows are half-open
  error_id: ERR_CHANGEOVER_CONFLICT
  http_status: 409
  applies_to: POST /production-lines/{line}/changeover
- priority: 13
  category: business_constraint
  check: For every CarTypeComponentRequirement of the order's car type whose component_class IN {WHEELSET, CASTING}, Component.on_hand_qty >= effective qty_per_car * production_order.quantity
  error_id: ERR_COMPONENT_SHORTAGE
  http_status: 409
  applies_to: POST /production-orders/{id}/reserve-components; POST /substitution-endorsements/{id}/approve
- priority: 14
  category: business_constraint
  check: order.required_delivery_date - order.order_date >= the worst gated component lead time per §1.3 production_feasibility_gate
  error_id: ERR_LEAD_TIME_INFEASIBLE
  http_status: 422
  applies_to: POST /production-orders; POST /production-orders/{id}/reserve-components
- priority: 15
  category: business_constraint
  check: No SubstitutionEndorsement on this production order with decides_material == true remains in APPROVED status when the order is released
  error_id: ERR_MATERIAL_ENDORSEMENT_PENDING
  http_status: 409
  applies_to: POST /production-orders/{id}/release
- priority: 16
  category: business_constraint
  check: 'Declared uniqueness holds: CarType.model_code, Component.part_number, Lessee.legal_name, RetrofitProgram.mandate_code, and the (car_type_id, component_id) pair of CarTypeComponentRequirement'
  error_id: ERR_DUPLICATE_ROW
  http_status: 409
  applies_to: POST /car-types; POST /components; POST /lessees; POST /retrofit-programs; POST /car-type-component-requirements
- priority: 17
  category: business_constraint
  check: Required fields are present, enum members are legal, and numeric ranges hold (quantity >= 1, planned_shop_days == car_type.build_hours * quantity, term_end_date > term_start_date)
  error_id: ERR_INVALID_REQUEST
  http_status: 400
  applies_to: all write endpoints
- priority: 18
  category: business_fiscal
  check: Lessee.outstanding_balance_cents plus the return's projected mileage charge stays at or below the lessee's credit ceiling; a balance exactly equal to the ceiling passes
  error_id: ERR_CREDIT_LIMIT_EXCEEDED
  http_status: 402
  applies_to: POST /car-returns; POST /car-assignments
- priority: 19
  category: business_fiscal
  check: The fleet's live car count (status IN {HELD, ASSIGNED, UNDER_REPAIR}) plus the cars this order would add stays at or below the contract's fleet_car_cap
  error_id: ERR_FLEET_CAP_EXCEEDED
  http_status: 402
  applies_to: POST /production-orders/{id}/release; POST /production-orders/{id}/complete
- priority: 20
  category: business_fiscal
  check: A sale whose writeback_liability_cents exceeds its gain over book value may not settle; the settlement must be internally balanced
  error_id: ERR_SETTLEMENT_UNBALANCED
  http_status: 409
  applies_to: POST /lease-fleet-sales/{id}/settle
- priority: 21
  category: business_referential
  check: lease_fleet_car.status == HELD for operations that require a free car
  error_id: ERR_CAR_NOT_HELD
  http_status: 409
  applies_to: POST /lease-fleet-sales; POST /car-assignments; POST /retrofit-work-orders; POST /lease-fleet-cars/{id}/scrap
- priority: 22
  category: business_referential
  check: The lessee named in the request is the lessee of the referenced contract or of the sold car's terminated contract
  error_id: ERR_LESSEE_MISMATCH
  http_status: 409
  applies_to: POST /car-assignments; POST /lease-fleet-sales
- priority: 23
  category: business_referential
  check: Every CarReturn of a car has settlement_status == SETTLED before the car may leave UNDER_REPAIR
  error_id: ERR_UNSETTLED_RETURNS
  http_status: 409
  applies_to: POST /lease-fleet-cars/{id}/settle-returns
- priority: 24
  category: business_constraint
  check: The car's car type is covered by the retrofit program through a RetrofitProgramCarType row
  error_id: ERR_CAPACITY_EXCEEDED
  http_status: 409
  applies_to: POST /retrofit-work-orders
concurrency_rules:
- rule_id: amendment-redraft-stale-contract
  parent_entity: LeaseContract
  write_endpoint: POST /lease-contracts/{id}/amendments
  occ_field: expected_lease_version
  description: 'Redrafting an amendment on a contract whose version has advanced since the

    client last observed it is rejected with ERR_STALE_VERSION. A second draft

    legitimately supersedes the first under the product semantics of §1.2

    (a contract still in AMENDMENT_DRAFTED may be redrafted before ratification),

    so the two writes are distinguished only by the version the writer observed.

    '
  error_id: ERR_STALE_VERSION
  http_status: 412
- rule_id: endorsement-supersede-stale-order
  parent_entity: ProductionOrder
  write_endpoint: POST /substitution-endorsements
  occ_field: expected_production_order_version
  description: 'Creating a substitution endorsement against a production order whose version

    has advanced since the client last observed it is rejected with

    ERR_STALE_VERSION. A newly created endorsement for the same original

    component legitimately supersedes the previously PENDING endorsement on that

    order, so the two writes are distinguished only by the version the writer observed.

    '
  error_id: ERR_STALE_VERSION
  http_status: 412
endpoints:
- method: POST
  path: /api/v1/car-types
  description: Create a car type in the production catalogue.
  roles:
  - ProductionPlanner
  - RegulatoryRetrofitist
  code: 201
  input:
  - model_code
  - car_class
  - build_hours
  - regulatory_life_years
  - line_count_family
  output: CarType
  side_effects:
  - Increments the acting planner's car-type count; no cross-entity effects.
- method: GET
  path: /api/v1/car-types/{id}
  description: Read one car type.
  roles:
  - PlatformAdmin
  - SupplyChainCoordinator
  - ProductionPlanner
  - LeaseAdministrator
  - PortfolioManager
  - RegulatoryRetrofitist
  - Lessee
  code: 200
  input: []
  output: CarType
  side_effects: []
- method: POST
  path: /api/v1/components
  description: Register a component part with its cost and supplier lead time.
  roles:
  - SupplyChainCoordinator
  code: 201
  input:
  - part_number
  - component_class
  - unit_cost_cents
  - lead_time_days
  - on_hand_qty?
  output: Component
  side_effects:
  - Recomputes reserved_qty and shortfall_qty per §1.3 component_allocation.
- method: GET
  path: /api/v1/components/{id}
  description: Read one component with its derived reserved_qty and shortfall_qty.
  roles:
  - PlatformAdmin
  - SupplyChainCoordinator
  - ProductionPlanner
  - LeaseAdministrator
  - PortfolioManager
  - RegulatoryRetrofitist
  - Lessee
  code: 200
  input: []
  output: Component
  side_effects: []
- method: POST
  path: /api/v1/car-type-component-requirements
  description: Add a bill-of-material row binding a component to a car type at a per-car quantity.
  roles:
  - ProductionPlanner
  code: 201
  input:
  - car_type_id
  - component_id
  - qty_per_car
  output: CarTypeComponentRequirement
  side_effects:
  - Recomputes the affected Component.reserved_qty per §1.3 component_allocation.
- method: GET
  path: /api/v1/car-type-component-requirements
  description: List bill-of-material rows, filterable by car type or component.
  roles:
  - PlatformAdmin
  - SupplyChainCoordinator
  - ProductionPlanner
  - LeaseAdministrator
  - PortfolioManager
  - RegulatoryRetrofitist
  - Lessee
  code: 200
  input:
  - limit?
  - offset?
  - car_type_id?
  - component_id?
  output: CarTypeComponentRequirement[]
  side_effects: []
- method: POST
  path: /api/v1/production-orders
  description: Take a customer order for cars of one type, evaluated for lead-time feasibility and quoted per §1.3 order_price_quote.
  roles:
  - ProductionPlanner
  code: 201
  input:
  - car_type_id
  - quantity
  - unit_price_cents?
  - planned_shop_days
  - disposition
  - priority_rank
  - order_date
  - required_delivery_date
  - lessee_id?
  - supersedes_production_order_id?
  output: ProductionOrder
  side_effects:
  - Sets unit_price_cents per §1.3 order_price_quote (forecast variant when DRAFT); evaluates §1.3 production_feasibility_gate; status starts DRAFT.
- method: GET
  path: /api/v1/production-orders
  description: List production orders, filterable by status and car type.
  roles:
  - PlatformAdmin
  - SupplyChainCoordinator
  - ProductionPlanner
  - LeaseAdministrator
  - PortfolioManager
  - RegulatoryRetrofitist
  - Lessee
  code: 200
  input:
  - limit?
  - offset?
  - status?
  - car_type_id?
  - supersedes_production_order_id?
  output: ProductionOrder[]
  side_effects: []
- method: GET
  path: /api/v1/production-orders/{id}
  description: Read one production order.
  roles:
  - PlatformAdmin
  - SupplyChainCoordinator
  - ProductionPlanner
  - LeaseAdministrator
  - PortfolioManager
  - RegulatoryRetrofitist
  - Lessee
  code: 200
  input: []
  output: ProductionOrder
  side_effects: []
- method: GET
  path: /api/v1/production-orders/{id}/superseding-orders
  description: List orders that superseded this production order.
  roles:
  - PlatformAdmin
  - SupplyChainCoordinator
  - ProductionPlanner
  - LeaseAdministrator
  - PortfolioManager
  - RegulatoryRetrofitist
  - Lessee
  code: 200
  input:
  - limit?
  - offset?
  output: ProductionOrder[]
  side_effects: []
- method: POST
  path: /api/v1/production-orders/{id}/reserve-components
  description: Commit wheelset and casting stock to the order and quote the committed price.
  roles:
  - ProductionPlanner
  code: 200
  input: []
  output: ProductionOrder
  side_effects:
  - Decrements Component.on_hand_qty and recomputes Component.reserved_qty per §1.3 component_allocation; recomputes unit_price_cents per §1.3 order_price_quote (committed variant); may auto-approve a matching PENDING SubstitutionEndorsement; status becomes COMPONENT_RESERVED; increments production_order.version.
- method: POST
  path: /api/v1/production-orders/{id}/release
  description: Release the fully sourced order to the backlog for line scheduling.
  roles:
  - ProductionPlanner
  code: 200
  input:
  - lease_contract_id?
  output: ProductionOrder
  side_effects:
  - Sets status RELEASED; applies every APPROVED SubstitutionEndorsement of the order (status APPLIED) and recomputes unit_price_cents; when disposition is RETAINED recomputes LeaseContract.capital_allocation_cents per §1.3 lease_fleet_capital_allocation; increments production_order.version.
- method: POST
  path: /api/v1/production-lines/{line}/changeover
  description: Schedule a line changeover and start production of the head-of-backlog order on that line.
  roles:
  - ProductionPlanner
  code: 200
  input:
  - production_order_id
  - scheduled_start_date
  - scheduled_end_date
  output: ProductionOrder
  side_effects:
  - Sets the order status IN_PRODUCTION and planned_shop_days to the window width; increments production_order.version.
- method: POST
  path: /api/v1/production-orders/{id}/complete
  description: Complete the remaining cars of an in-production order.
  roles:
  - ProductionPlanner
  code: 200
  input:
  - completed_qty
  - lessee_id?
  - completion_date?
  output: ProductionOrder
  side_effects:
  - Sets status COMPLETED; for SOLD orders debits Lessee.outstanding_balance_cents; for RETAINED orders creates one LeaseFleetCar per car (status HELD), recomputes LeaseContract.capital_allocation_cents per §1.3 lease_fleet_capital_allocation and PortfolioLedger.committed_capital_cents and fleet_nbv_cents per §1.3 fleet_capital_reconciliation; increments production_order.version.
- method: POST
  path: /api/v1/production-orders/{id}/cancel
  description: Cancel a draft or component-reserved order.
  roles:
  - ProductionPlanner
  code: 200
  input:
  - reason?
  output: ProductionOrder
  side_effects:
  - Restores Component.on_hand_qty for covered rows; sets every live SubstitutionEndorsement of the order to SUPERSEDED; increments production_order.version.
- method: POST
  path: /api/v1/substitution-endorsements
  description: Raise a substitution endorsement offering a substitute component for a short one.
  roles:
  - ProductionPlanner
  - RegulatoryRetrofitist
  code: 201
  input:
  - production_order_id
  - original_component_id
  - substitute_component_id
  - substitute_qty_per_car
  - decides_material
  - expected_production_order_version
  output: SubstitutionEndorsement
  side_effects:
  - Supersedes any earlier PENDING endorsement for the same original component on the order; increments production_order.version.
- method: GET
  path: /api/v1/substitution-endorsements
  description: List substitution endorsements.
  roles:
  - PlatformAdmin
  - SupplyChainCoordinator
  - ProductionPlanner
  - LeaseAdministrator
  - PortfolioManager
  - RegulatoryRetrofitist
  - Lessee
  code: 200
  input:
  - limit?
  - offset?
  - production_order_id?
  - status?
  - original_component_id?
  - substitute_component_id?
  output: SubstitutionEndorsement[]
  side_effects: []
- method: GET
  path: /api/v1/substitution-endorsements/{id}
  description: Read one substitution endorsement.
  roles:
  - PlatformAdmin
  - SupplyChainCoordinator
  - ProductionPlanner
  - LeaseAdministrator
  - PortfolioManager
  - RegulatoryRetrofitist
  - Lessee
  code: 200
  input: []
  output: SubstitutionEndorsement
  side_effects: []
- method: POST
  path: /api/v1/substitution-endorsements/{id}/approve
  description: Approve an endorsement as a second person; recomputes the order quote with the substitute.
  roles:
  - LeaseAdministrator
  code: 200
  input: []
  output: SubstitutionEndorsement
  side_effects:
  - Sets status APPROVED; recomputes ProductionOrder.unit_price_cents per §1.3 order_price_quote; increments substitution_endorsement.version.
- method: PATCH
  path: /api/v1/substitution-endorsements/{id}
  description: Reject a pending endorsement, or return a rejected one to pending for another attempt.
  roles:
  - LeaseAdministrator
  - ProductionPlanner
  code: 200
  input:
  - status
  - expected_substitution_endorsement_version?
  output: SubstitutionEndorsement
  side_effects:
  - Sets status REJECTED or PENDING; increments substitution_endorsement.version.
- method: POST
  path: /api/v1/lease-contracts
  description: Write a lease contract with its rate, maintenance responsibility and fleet cap.
  roles:
  - LeaseAdministrator
  code: 201
  input:
  - lessee_id
  - lease_type
  - per_diem_rate_cents
  - liability_bearer
  - term_start_date
  - term_end_date
  - fleet_car_cap
  output: LeaseContract
  side_effects:
  - Status starts DRAFT; amendment_seq starts at 0.
- method: GET
  path: /api/v1/lease-contracts
  description: List lease contracts, filterable by status or lessee.
  roles:
  - PlatformAdmin
  - SupplyChainCoordinator
  - ProductionPlanner
  - LeaseAdministrator
  - PortfolioManager
  - RegulatoryRetrofitist
  - Lessee
  code: 200
  input:
  - limit?
  - offset?
  - status?
  - lessee_id?
  output: LeaseContract[]
  side_effects: []
- method: GET
  path: /api/v1/lease-contracts/{id}
  description: Read one lease contract.
  roles:
  - PlatformAdmin
  - SupplyChainCoordinator
  - ProductionPlanner
  - LeaseAdministrator
  - PortfolioManager
  - RegulatoryRetrofitist
  - Lessee
  code: 200
  input: []
  output: LeaseContract
  side_effects: []
- method: POST
  path: /api/v1/lease-contracts/{id}/activate
  description: Put a drafted contract into force.
  roles:
  - LeaseAdministrator
  code: 200
  input: []
  output: LeaseContract
  side_effects:
  - Sets status ACTIVE; increments lease_contract.version.
- method: POST
  path: /api/v1/lease-contracts/{id}/amendments
  description: Draft an amendment changing the rate or the maintenance liability bearer.
  roles:
  - LeaseAdministrator
  code: 200
  input:
  - per_diem_rate_cents
  - liability_bearer
  - expected_lease_version
  output: LeaseContract
  side_effects:
  - Sets status AMENDMENT_DRAFTED; increments lease_contract.version.
- method: POST
  path: /api/v1/lease-contracts/{id}/amendments/ratify
  description: Ratify the drafted amendment, restating live assignments and their accruals.
  roles:
  - LeaseAdministrator
  code: 200
  input:
  - expected_lease_version
  output: LeaseContract
  side_effects:
  - Sets status ACTIVE and increments amendment_seq; refreshes per_diem_rate_cents on every ACTIVE assignment of the contract and recomputes per_diem_accrued_cents per §1.3 assignment_per_diem_accrual; reallocates maintenance_cost_cents per §1.3 maintenance_burden_allocation; increments lease_contract.version.
- method: POST
  path: /api/v1/lease-contracts/{id}/terminate
  description: Terminate a contract, closing its live placements unless they are enumerated for cascade closure.
  roles:
  - LeaseAdministrator
  code: 200
  input:
  - cascade_assignment_ids?
  output: LeaseContract
  side_effects:
  - Sets status TERMINATED; closes enumerated assignments and returns their cars to HELD; increments lease_contract.version.
- method: POST
  path: /api/v1/lessees
  description: Register a lessee account with its credit tier, ceiling and utilization threshold.
  roles:
  - LeaseAdministrator
  code: 201
  input:
  - legal_name
  - credit_tier
  - utilization_threshold_pct
  - credit_ceiling_cents
  output: Lessee
  side_effects:
  - Status starts ACTIVE; outstanding_balance_cents starts at 0.
- method: GET
  path: /api/v1/lessees/{id}/outstanding-balance
  description: Compute the lessee's ledger balance and its components per §1.3 lessee_balance_reconciliation.
  roles:
  - PlatformAdmin
  - SupplyChainCoordinator
  - ProductionPlanner
  - LeaseAdministrator
  - PortfolioManager
  - RegulatoryRetrofitist
  - Lessee
  code: 200
  input: []
  output: '{ outstanding_balance_cents: integer, settled_charges_cents: integer, credits_applied_cents: integer }'
  side_effects: []
- method: GET
  path: /api/v1/lease-fleet-cars
  description: List lease fleet cars, filterable by status, car type, contract or producing order.
  roles:
  - PlatformAdmin
  - SupplyChainCoordinator
  - ProductionPlanner
  - LeaseAdministrator
  - PortfolioManager
  - RegulatoryRetrofitist
  - Lessee
  code: 200
  input:
  - limit?
  - offset?
  - status?
  - car_type_id?
  - lease_contract_id?
  - production_order_id?
  output: LeaseFleetCar[]
  side_effects: []
- method: GET
  path: /api/v1/lease-fleet-cars/{id}
  description: Read one lease fleet car with its derived life end date and retrofit flag.
  roles:
  - PlatformAdmin
  - SupplyChainCoordinator
  - ProductionPlanner
  - LeaseAdministrator
  - PortfolioManager
  - RegulatoryRetrofitist
  - Lessee
  code: 200
  input: []
  output: LeaseFleetCar
  side_effects: []
- method: POST
  path: /api/v1/lease-fleet-cars/{id}/settle-returns
  description: Close out a repaired car once every return against it is settled.
  roles:
  - ProductionPlanner
  code: 200
  input: []
  output: LeaseFleetCar
  side_effects:
  - Sets status HELD and clears lease_contract_id; recomputes retrofit_required; increments lease_fleet_car.version.
- method: POST
  path: /api/v1/lease-fleet-cars/{id}/scrap
  description: Scrap a car at the end of its regulatory life or as an economic write-off.
  roles:
  - PortfolioManager
  code: 200
  input:
  - scrap_reason?
  output: LeaseFleetCar
  side_effects:
  - Sets status SCRAPPED; deletes SCHEDULED RetrofitWorkOrders of the car and cancels the rest; recomputes LeaseContract.capital_allocation_cents per §1.3 lease_fleet_capital_allocation; increments lease_fleet_car.version.
- method: POST
  path: /api/v1/car-assignments
  description: Place a free car with a lessee under an active contract; enforces overlap buffering and the credit ceiling.
  roles:
  - LeaseAdministrator
  code: 201
  input:
  - lease_fleet_car_id
  - lease_contract_id
  - lessee_id
  - start_date
  - end_date
  - mileage_allowance
  output: CarAssignment
  side_effects:
  - Sets the car status ASSIGNED and stamps lease_contract_id; snapshots per_diem_rate_cents from the contract; computes per_diem_accrued_cents per §1.3 assignment_per_diem_accrual; increments lease_fleet_car.version.
- method: GET
  path: /api/v1/car-assignments
  description: List car placements, filterable by status, car or contract.
  roles:
  - PlatformAdmin
  - SupplyChainCoordinator
  - ProductionPlanner
  - LeaseAdministrator
  - PortfolioManager
  - RegulatoryRetrofitist
  - Lessee
  code: 200
  input:
  - limit?
  - offset?
  - status?
  - lease_fleet_car_id?
  - lease_contract_id?
  output: CarAssignment[]
  side_effects: []
- method: GET
  path: /api/v1/car-assignments/{id}
  description: Read one car placement.
  roles:
  - PlatformAdmin
  - SupplyChainCoordinator
  - ProductionPlanner
  - LeaseAdministrator
  - PortfolioManager
  - RegulatoryRetrofitist
  - Lessee
  code: 200
  input: []
  output: CarAssignment
  side_effects: []
- method: POST
  path: /api/v1/car-assignments/{id}/suspend
  description: Suspend a placement, stopping the per-diem meter and pulling the car back to the fleet.
  roles:
  - LeaseAdministrator
  code: 200
  input:
  - suspend_date?
  output: CarAssignment
  side_effects:
  - Sets status SUSPENDED; sets the car status HELD; recomputes per_diem_accrued_cents per §1.3 assignment_per_diem_accrual; increments both versions.
- method: POST
  path: /api/v1/car-assignments/{id}/resume
  description: Resume a suspended or reassigned placement.
  roles:
  - LeaseAdministrator
  code: 200
  input: []
  output: CarAssignment
  side_effects:
  - Sets status ACTIVE; sets the car status ASSIGNED; increments both versions.
- method: POST
  path: /api/v1/car-assignments/{id}/reassign
  description: Move a placement to another free car under the same contract.
  roles:
  - LeaseAdministrator
  code: 200
  input:
  - target_lease_fleet_car_id
  - effective_date?
  output: CarAssignment
  side_effects:
  - Sets status REASSIGNED on the source placement; creates a replacement CarAssignment on the target car; increments both versions.
- method: POST
  path: /api/v1/car-returns
  description: Record a car coming back off a placement; accrues the mileage true-up and closes the placement.
  roles:
  - LeaseAdministrator
  code: 201
  input:
  - lease_fleet_car_id
  - car_assignment_id
  - return_date
  - mileage_since_last
  - condition_grade
  output: CarReturn
  side_effects:
  - Sets the placement status COMPLETED and the car status UNDER_REPAIR; recomputes CarReturn.mileage_overage_cents and Lessee.outstanding_balance_cents per §1.3 mileage_true_up_settlement and lessee_balance_reconciliation; recomputes the car accumulated_mileage; increments car_assignment.version and lease_fleet_car.version.
- method: GET
  path: /api/v1/car-returns
  description: List returns, filterable by car, placement or settlement status.
  roles:
  - PlatformAdmin
  - SupplyChainCoordinator
  - ProductionPlanner
  - LeaseAdministrator
  - PortfolioManager
  - RegulatoryRetrofitist
  - Lessee
  code: 200
  input:
  - limit?
  - offset?
  - lease_fleet_car_id?
  - car_assignment_id?
  - settlement_status?
  output: CarReturn[]
  side_effects: []
- method: POST
  path: /api/v1/car-returns/{id}/settle
  description: Settle a return, moving its charge into the lessee ledger.
  roles:
  - PortfolioManager
  code: 200
  input: []
  output: CarReturn
  side_effects:
  - Sets settlement_status SETTLED; recomputes Lessee.outstanding_balance_cents per §1.3 lessee_balance_reconciliation; increments car_return.version.
- method: POST
  path: /api/v1/retrofit-programs
  description: Open a regulatory retrofit mandate program.
  roles:
  - RegulatoryRetrofitist
  code: 201
  input:
  - mandate_code
  - description
  - compliance_deadline_date
  - required_shop_days_per_car
  - required_component_id?
  output: RetrofitProgram
  side_effects:
  - Status starts PLANNED; program_cost_cents starts 0.
- method: GET
  path: /api/v1/retrofit-programs
  description: List retrofit programs.
  roles:
  - PlatformAdmin
  - SupplyChainCoordinator
  - ProductionPlanner
  - LeaseAdministrator
  - PortfolioManager
  - RegulatoryRetrofitist
  - Lessee
  code: 200
  input:
  - limit?
  - offset?
  - status?
  - required_component_id?
  output: RetrofitProgram[]
  side_effects: []
- method: POST
  path: /api/v1/retrofit-programs/{id}/start
  description: Start the program, enrolling every covered fleet car.
  roles:
  - RegulatoryRetrofitist
  code: 200
  input: []
  output: RetrofitProgram
  side_effects:
  - Sets status IN_PROGRESS; sets retrofit_required on every covered LeaseFleetCar; recomputes program_cost_cents per §1.3 retrofit_program_cost_allocation; increments retrofit_program.version and every enrolled lease_fleet_car.version.
- method: POST
  path: /api/v1/retrofit-programs/{id}/complete
  description: Close the program once every covered car type has completed work.
  roles:
  - RegulatoryRetrofitist
  code: 200
  input: []
  output: RetrofitProgram
  side_effects:
  - Sets status COMPLETED; clears retrofit_required on covered cars; recomputes program_cost_cents per §1.3 retrofit_program_cost_allocation (completed_actual variant); increments retrofit_program.version.
- method: POST
  path: /api/v1/retrofit-programs/{id}/void
  description: Void the program, cancelling its work orders.
  roles:
  - RegulatoryRetrofitist
  code: 200
  input:
  - reason?
  output: RetrofitProgram
  side_effects:
  - Sets status VOIDED; cancels every work order and clears retrofit_required on enrolled cars; increments retrofit_program.version.
- method: POST
  path: /api/v1/retrofit-program-car-types
  description: Cover a car type under a retrofit program.
  roles:
  - RegulatoryRetrofitist
  code: 201
  input:
  - retrofit_program_id
  - car_type_id
  output: RetrofitProgramCarType
  side_effects: []
- method: GET
  path: /api/v1/retrofit-program-car-types
  description: List program-to-car-type coverage rows.
  roles:
  - PlatformAdmin
  - SupplyChainCoordinator
  - ProductionPlanner
  - LeaseAdministrator
  - PortfolioManager
  - RegulatoryRetrofitist
  - Lessee
  code: 200
  input:
  - limit?
  - offset?
  - retrofit_program_id?
  - car_type_id?
  output: RetrofitProgramCarType[]
  side_effects: []
- method: POST
  path: /api/v1/retrofit-work-orders
  description: Schedule retrofit shop work on a shop line for a covered car.
  roles:
  - ProductionPlanner
  - RegulatoryRetrofitist
  code: 201
  input:
  - retrofit_program_id
  - lease_fleet_car_id
  - shop_line
  - scheduled_start_date
  - scheduled_end_date
  - component_qty_consumed
  output: RetrofitWorkOrder
  side_effects:
  - Sets the car status UNDER_REPAIR and retrofit_required true; increments lease_fleet_car.version.
- method: GET
  path: /api/v1/retrofit-work-orders
  description: List retrofit work orders, filterable by status, shop line, car or program.
  roles:
  - PlatformAdmin
  - SupplyChainCoordinator
  - ProductionPlanner
  - LeaseAdministrator
  - PortfolioManager
  - RegulatoryRetrofitist
  - Lessee
  code: 200
  input:
  - limit?
  - offset?
  - status?
  - shop_line?
  - lease_fleet_car_id?
  - retrofit_program_id?
  output: RetrofitWorkOrder[]
  side_effects: []
- method: POST
  path: /api/v1/retrofit-work-orders/{id}/start
  description: Start shop work, consuming the mandate's retrofit component kit.
  roles:
  - ProductionPlanner
  code: 200
  input: []
  output: RetrofitWorkOrder
  side_effects:
  - Sets status IN_PROGRESS; decrements Component.on_hand_qty and recomputes reserved_qty per §1.3 component_allocation; increments retrofit_work_order.version.
- method: POST
  path: /api/v1/retrofit-work-orders/{id}/complete
  description: Complete shop work, returning the car to service with a reset life clock.
  roles:
  - ProductionPlanner
  code: 200
  input: []
  output: RetrofitWorkOrder
  side_effects:
  - Sets status COMPLETED; sets the car status HELD and resets its built_date and regulatory_life_end_date; recomputes RetrofitProgram.program_cost_cents per §1.3 retrofit_program_cost_allocation; increments retrofit_work_order.version and lease_fleet_car.version.
- method: POST
  path: /api/v1/retrofit-work-orders/{id}/cancel
  description: Cancel scheduled shop work before it starts.
  roles:
  - ProductionPlanner
  code: 200
  input:
  - reason?
  output: RetrofitWorkOrder
  side_effects:
  - Sets status CANCELLED; increments retrofit_work_order.version.
- method: POST
  path: /api/v1/component-purchase-orders
  description: Raise a purchase order for a component against its supplier lead time.
  roles:
  - SupplyChainCoordinator
  code: 201
  input:
  - component_id
  - qty_ordered
  - unit_cost_cents
  - order_date
  - expected_receipt_date
  output: ComponentPurchaseOrder
  side_effects:
  - Status starts PLACED.
- method: GET
  path: /api/v1/component-purchase-orders
  description: List purchase orders, filterable by status or component.
  roles:
  - PlatformAdmin
  - SupplyChainCoordinator
  - ProductionPlanner
  - LeaseAdministrator
  - PortfolioManager
  - RegulatoryRetrofitist
  - Lessee
  code: 200
  input:
  - limit?
  - offset?
  - status?
  - component_id?
  output: ComponentPurchaseOrder[]
  side_effects: []
- method: POST
  path: /api/v1/component-purchase-orders/{id}/confirm
  description: Confirm a placed purchase with the supplier.
  roles:
  - SupplyChainCoordinator
  code: 200
  input: []
  output: ComponentPurchaseOrder
  side_effects:
  - Sets status CONFIRMED; increments component_purchase_order.version.
- method: POST
  path: /api/v1/component-purchase-orders/{id}/cancel
  description: Cancel a placed purchase before confirmation.
  roles:
  - SupplyChainCoordinator
  code: 200
  input:
  - reason?
  output: ComponentPurchaseOrder
  side_effects:
  - Sets status CANCELLED; increments component_purchase_order.version.
- method: POST
  path: /api/v1/component-receipts
  description: Book receipt of a component delivery in the yard.
  roles:
  - SupplyChainCoordinator
  code: 201
  input:
  - component_purchase_order_id
  - component_id
  - qty_received
  - receipt_date
  output: ComponentReceipt
  side_effects: []
- method: GET
  path: /api/v1/component-receipts
  description: List component receipts.
  roles:
  - PlatformAdmin
  - SupplyChainCoordinator
  - ProductionPlanner
  - LeaseAdministrator
  - PortfolioManager
  - RegulatoryRetrofitist
  - Lessee
  code: 200
  input:
  - limit?
  - offset?
  - component_id?
  - component_purchase_order_id?
  output: ComponentReceipt[]
  side_effects: []
- method: POST
  path: /api/v1/component-receipts/{id}/receive
  description: Apply a booked receipt to stock, increasing the component on-hand quantity.
  roles:
  - SupplyChainCoordinator
  code: 200
  input: []
  output: ComponentReceipt
  side_effects:
  - Sets the parent purchase order status RECEIVED; increases Component.on_hand_qty by qty_received and recomputes reserved_qty and shortfall_qty per §1.3 component_allocation; increments component_purchase_order.version and component.version.
- method: POST
  path: /api/v1/lease-fleet-sales
  description: Sell a fleet car on the secondary market, terminating its contract and marking it sold.
  roles:
  - PortfolioManager
  code: 201
  input:
  - lease_fleet_car_id
  - lease_contract_id?
  - buyer_name
  - sale_price_cents
  - net_book_value_cents?
  - writeback_liability_cents
  - sale_date
  output: LeaseFleetSale
  side_effects:
  - Sets the car status SOLD and clears its contract; computes net_book_value_cents and gain_loss_cents per §1.3 sale_gain_loss; when the terminated contract's liability_bearer was LESSEE recomputes Lessee.outstanding_balance_cents per §1.3 lessee_balance_reconciliation; increments lease_fleet_car.version.
- method: GET
  path: /api/v1/lease-fleet-sales
  description: List secondary-market sales.
  roles:
  - PlatformAdmin
  - SupplyChainCoordinator
  - ProductionPlanner
  - LeaseAdministrator
  - PortfolioManager
  - RegulatoryRetrofitist
  - Lessee
  code: 200
  input:
  - limit?
  - offset?
  - status?
  - lease_fleet_car_id?
  - lease_contract_id?
  output: LeaseFleetSale[]
  side_effects: []
- method: POST
  path: /api/v1/lease-fleet-sales/{id}/settle
  description: Settle a pending sale into the portfolio ledger.
  roles:
  - PortfolioManager
  code: 200
  input: []
  output: LeaseFleetSale
  side_effects:
  - Sets status SETTLED; adjusts PortfolioLedger.realized_gain_cents by gain_loss_cents and recomputes fleet_nbv_cents per §1.3 fleet_capital_reconciliation; credits Lessee.outstanding_balance_cents by writeback_liability_cents; increments lease_fleet_sale.version and portfolio_ledger.version.
- method: POST
  path: /api/v1/lease-fleet-sales/{id}/void
  description: Void a pending sale and return the car to the fleet.
  roles:
  - PortfolioManager
  code: 200
  input:
  - reason?
  output: LeaseFleetSale
  side_effects:
  - Sets status VOIDED and the car status HELD; leaves PortfolioLedger.realized_gain_cents unchanged; increments lease_fleet_sale.version.
- method: GET
  path: /api/v1/portfolio-ledger
  description: Read the singleton portfolio ledger with its committed capital, realized gains and current net book value.
  roles:
  - PlatformAdmin
  - SupplyChainCoordinator
  - ProductionPlanner
  - LeaseAdministrator
  - PortfolioManager
  - RegulatoryRetrofitist
  - Lessee
  code: 200
  input: []
  output: PortfolioLedger
  side_effects: []
- method: GET
  path: /api/v1/portfolio-ledger/reconciliation
  description: Compute both bases of fleet capital and their drift per §1.3 fleet_capital_reconciliation.
  roles:
  - PlatformAdmin
  - SupplyChainCoordinator
  - ProductionPlanner
  - LeaseAdministrator
  - PortfolioManager
  - RegulatoryRetrofitist
  - Lessee
  code: 200
  input: []
  output: '{ oldest_basis_cents: integer, newest_basis_cents: integer, drift_cents: integer, committed_capital_cents: integer, realized_gain_cents: integer }'
  side_effects: []
- method: POST
  path: /api/v1/_clock/set_current_utc
  description: Test-driving clock control. Sets the logical clock. The server's startup default is 2026-09-01T00:00:00Z; before any call the logical clock reads exactly that default and never falls back to wall-clock time.
  roles:
  - PlatformAdmin
  code: 200
  input:
  - to_iso8601
  output: '{ current_utc: string }'
  side_effects:
  - Every date-dependent rule (lead time, compliance deadline, regulatory life, accrual window, depreciation) is thereafter evaluated against the set instant.
- method: GET
  path: /api/v1/_clock/current
  description: Read the logical clock's current instant.
  roles:
  - PlatformAdmin
  - SupplyChainCoordinator
  - ProductionPlanner
  - LeaseAdministrator
  - PortfolioManager
  - RegulatoryRetrofitist
  - Lessee
  code: 200
  input: []
  output: '{ current_utc: string }'
  side_effects: []
- method: GET
  path: /api/v1/car-type-component-requirements/{id}
  description: Read one bill-of-material row.
  roles:
  - PlatformAdmin
  - SupplyChainCoordinator
  - ProductionPlanner
  - LeaseAdministrator
  - PortfolioManager
  - RegulatoryRetrofitist
  - Lessee
  code: 200
  input: []
  output: CarTypeComponentRequirement
  side_effects: []
- method: GET
  path: /api/v1/car-returns/{id}
  description: Read one return.
  roles:
  - PlatformAdmin
  - SupplyChainCoordinator
  - ProductionPlanner
  - LeaseAdministrator
  - PortfolioManager
  - RegulatoryRetrofitist
  - Lessee
  code: 200
  input: []
  output: CarReturn
  side_effects: []
- method: GET
  path: /api/v1/retrofit-program-car-types/{id}
  description: Read one program-to-car-type coverage row.
  roles:
  - PlatformAdmin
  - SupplyChainCoordinator
  - ProductionPlanner
  - LeaseAdministrator
  - PortfolioManager
  - RegulatoryRetrofitist
  - Lessee
  code: 200
  input: []
  output: RetrofitProgramCarType
  side_effects: []
- method: GET
  path: /api/v1/component-purchase-orders/{id}
  description: Read one purchase order.
  roles:
  - PlatformAdmin
  - SupplyChainCoordinator
  - ProductionPlanner
  - LeaseAdministrator
  - PortfolioManager
  - RegulatoryRetrofitist
  - Lessee
  code: 200
  input: []
  output: ComponentPurchaseOrder
  side_effects: []
- method: GET
  path: /api/v1/component-receipts/{id}
  description: Read one component receipt.
  roles:
  - PlatformAdmin
  - SupplyChainCoordinator
  - ProductionPlanner
  - LeaseAdministrator
  - PortfolioManager
  - RegulatoryRetrofitist
  - Lessee
  code: 200
  input: []
  output: ComponentReceipt
  side_effects: []
- method: GET
  path: /api/v1/retrofit-programs/{id}
  description: Read one retrofit program.
  roles:
  - PlatformAdmin
  - SupplyChainCoordinator
  - ProductionPlanner
  - LeaseAdministrator
  - PortfolioManager
  - RegulatoryRetrofitist
  - Lessee
  code: 200
  input: []
  output: RetrofitProgram
  side_effects: []
- method: GET
  path: /api/v1/retrofit-work-orders/{id}
  description: Read one retrofit work order.
  roles:
  - PlatformAdmin
  - SupplyChainCoordinator
  - ProductionPlanner
  - LeaseAdministrator
  - PortfolioManager
  - RegulatoryRetrofitist
  - Lessee
  code: 200
  input: []
  output: RetrofitWorkOrder
  side_effects: []
- method: GET
  path: /api/v1/lease-fleet-sales/{id}
  description: Read one fleet sale.
  roles:
  - PlatformAdmin
  - SupplyChainCoordinator
  - ProductionPlanner
  - LeaseAdministrator
  - PortfolioManager
  - RegulatoryRetrofitist
  - Lessee
  code: 200
  input: []
  output: LeaseFleetSale
  side_effects: []
errors:
- id: ERR_UNAUTHENTICATED
  http: 401
  condition: X-User-Role or X-User-ID is absent, or the role name is not declared in §1.7.
- id: ERR_FORBIDDEN
  http: 403
  condition: The acting role is not permitted for the endpoint's operation.
- id: ERR_SELF_APPROVAL_FORBIDDEN
  http: 403
  condition: The approving user is the same operator that created the substitution endorsement (segregation of duties).
- id: ERR_NOT_FOUND
  http: 404
  condition: A path-templated resource id does not resolve.
- id: ERR_COMPONENT_NOT_FOUND
  http: 404
  condition: A foreign key named in the request body does not resolve to a persisted row.
- id: ERR_INVALID_STATE
  http: 409
  condition: The target resource's status is not one from which the requested action is legal.
- id: ERR_ALREADY_TERMINAL
  http: 409
  condition: The target resource is in a terminal state and accepts no further transitions.
- id: ERR_STALE_VERSION
  http: 412
  condition: The supplied expected_*_version does not equal the parent's current version.
- id: ERR_REGULATORY_LIFE_EXCEEDED
  http: 422
  condition: The car's regulatory_life_end_date is before the operation date, so only scrapping remains legal.
- id: ERR_RETROFIT_DEADLINE_PASSED
  http: 422
  condition: The retrofit shop window ends after the mandate's compliance_deadline_date.
- id: ERR_SHOP_SLOT_OVERLAP
  http: 409
  condition: The requested retrofit shop window collides with another work order on the same shop_line.
- id: ERR_ASSIGNMENT_OVERLAP
  http: 409
  condition: The requested placement interval collides with another placement of the same car, or violates the one-day gap buffer.
- id: ERR_CHANGEOVER_CONFLICT
  http: 409
  condition: The requested changeover window collides with another changeover on the same production line family.
- id: ERR_COMPONENT_SHORTAGE
  http: 409
  condition: On-hand wheelset or casting stock is below the effective per-car requirement times the order quantity.
- id: ERR_LEAD_TIME_INFEASIBLE
  http: 422
  condition: The order-to-delivery horizon is shorter than the worst gated component lead time per §1.3 production_feasibility_gate.
- id: ERR_MATERIAL_ENDORSEMENT_PENDING
  http: 409
  condition: A material substitution endorsement on the order is still APPROVED and would change the car's composition in flight.
- id: ERR_ENDORSEMENT_RETRY_EXHAUSTED
  http: 409
  condition: A second return to PENDING was attempted on an endorsement that has already been rejected once.
- id: ERR_PREREQUISITE_NOT_MET
  http: 409
  condition: 'A required upstream aggregate is missing: the car type has no bill-of-material rows at reservation, or the program covers no car type at start.'
- id: ERR_DUPLICATE_ROW
  http: 409
  condition: A declared uniqueness constraint is violated (model code, part number, legal name, mandate code, or the car-type/component pair).
- id: ERR_INVALID_REQUEST
  http: 400
  condition: A required field is missing, an enum member is illegal, or a numeric range fails.
- id: ERR_CREDIT_LIMIT_EXCEEDED
  http: 402
  condition: The lessee's outstanding balance plus the projected charge would exceed the lessee's credit ceiling.
- id: ERR_FLEET_CAP_EXCEEDED
  http: 402
  condition: The fleet's live car count plus the cars this order would add exceeds the contract's fleet_car_cap.
- id: ERR_SETTLEMENT_UNBALANCED
  http: 409
  condition: A sale's writeback liability exceeds its gain over book value, so the settlement cannot balance.
- id: ERR_CAR_NOT_HELD
  http: 409
  condition: The car referenced by a sale, placement, retrofit or scrap request is not in status HELD.
- id: ERR_LESSEE_MISMATCH
  http: 409
  condition: The lessee named in the request is not the lessee of the referenced contract or sold car.
- id: ERR_UNSETTLED_RETURNS
  http: 409
  condition: A car still has returns whose settlement_status is PENDING, so it may not leave UNDER_REPAIR.
- id: ERR_CAPACITY_EXCEEDED
  http: 409
  condition: The car's car type is not covered by the retrofit program named on the work order.
roles:
- name: PlatformAdmin
  description: Platform operator with unconditional override; owns the logical clock.
  identity: opaque
  exclusive_operations:
  - POST /_clock/set_current_utc
  shared_operations:
  - All GET reads
  - All catalog and ledger reads
- name: SupplyChainCoordinator
  description: Owns the component catalogue, purchase orders and yard receipts.
  identity: opaque
  exclusive_operations:
  - POST /components
  - POST /component-purchase-orders
  - POST /component-purchase-orders/{id}/confirm
  - POST /component-purchase-orders/{id}/cancel
  - POST /component-receipts
  - POST /component-receipts/{id}/receive
  shared_operations:
  - All GET reads
- name: ProductionPlanner
  description: Owns the order backlog, the production line schedule and shop work.
  identity: opaque
  exclusive_operations:
  - POST /car-type-component-requirements
  - POST /production-orders
  - POST /production-orders/{id}/reserve-components
  - POST /production-orders/{id}/release
  - POST /production-lines/{line}/changeover
  - POST /production-orders/{id}/complete
  - POST /production-orders/{id}/cancel
  - POST /retrofit-work-orders/{id}/start
  - POST /retrofit-work-orders/{id}/complete
  - POST /retrofit-work-orders/{id}/cancel
  - POST /lease-fleet-cars/{id}/settle-returns
  - PATCH /substitution-endorsements/{id}
  shared_operations:
  - POST /car-types
  - POST /substitution-endorsements
  - POST /retrofit-work-orders
  - All GET reads
- name: LeaseAdministrator
  description: Owns lease contracts, placements and the return desk; second-person approver for endorsements.
  identity: opaque
  exclusive_operations:
  - POST /lessees
  - POST /lease-contracts
  - POST /lease-contracts/{id}/activate
  - POST /lease-contracts/{id}/amendments
  - POST /lease-contracts/{id}/amendments/ratify
  - POST /lease-contracts/{id}/terminate
  - POST /car-assignments
  - POST /car-assignments/{id}/suspend
  - POST /car-assignments/{id}/resume
  - POST /car-assignments/{id}/reassign
  - POST /car-returns
  - POST /substitution-endorsements/{id}/approve
  - PATCH /substitution-endorsements/{id}
  shared_operations:
  - All GET reads
- name: PortfolioManager
  description: 'Owns fleet portfolio economics: secondary-market sales, scrapping and return settlement.'
  identity: opaque
  exclusive_operations:
  - POST /lease-fleet-sales
  - POST /lease-fleet-sales/{id}/settle
  - POST /lease-fleet-sales/{id}/void
  - POST /lease-fleet-cars/{id}/scrap
  - POST /car-returns/{id}/settle
  shared_operations:
  - All GET reads
- name: RegulatoryRetrofitist
  description: Owns regulatory retrofit mandates, their covered car types and program closure.
  identity: opaque
  exclusive_operations:
  - POST /retrofit-programs
  - POST /retrofit-programs/{id}/start
  - POST /retrofit-programs/{id}/complete
  - POST /retrofit-programs/{id}/void
  - POST /retrofit-program-car-types
  shared_operations:
  - POST /car-types
  - POST /substitution-endorsements
  - POST /retrofit-work-orders
  - All GET reads
- name: Lessee
  description: A lessee account reading its own contracts, placements and balance.
  identity: entity_backed:Lessee
  exclusive_operations: []
  shared_operations:
  - All GET reads
  - GET /lessees/{id}/outstanding-balance for its own id only
