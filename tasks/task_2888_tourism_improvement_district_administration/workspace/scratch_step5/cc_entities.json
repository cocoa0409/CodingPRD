 {
  "name": "assessment_filing_missing_the_revenue_field_is_rejected",
  "grounds": [
   "endpoints.POST_/assessment-statements/{id}/filings",
   "entities.AssessmentStatement.fields.reported_gross_room_revenue_cents",
   "validations.priority_30_ERR_INVALID_REQUEST",
   "errors[ERR_INVALID_REQUEST]"
  ],
  "setup": [
   "district ACTIVE with the canonical roll; FY2027-Q1 open; statements generated",
   "logical clock 2026-08-01T00:00:00Z, inside the filing window"
  ],
  "setup_api_calls": [
   "@A1",
   "@A2",
   "@A3",
   "@A4",
   "@A5",
   "@A6",
   "@A7",
   "@A8",
   "@A9",
   "@A10",
   "@A11",
   "@A12",
   "@A13",
   "@A14"
  ],
  "trigger": [
   {
    "call": "POST /assessment-statements/${st1_id}/filings",
    "payload": {
     "reported_room_nights": 2000
    },
    "as": "LodgingOperator",
    "as_user_id": "${b1_id}"
   }
  ],
  "assert": [
   "the response status is 400",
   "data.error_id == ERR_INVALID_REQUEST",
