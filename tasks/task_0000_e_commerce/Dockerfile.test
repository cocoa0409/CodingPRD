# Test container for e_commerce task
# Built by prd-bench-docker-runner with a composite build context containing:
#   - prd-bench-local-runner/ (testing framework)
#   - test_helpers/ (domain-specific test infrastructure)
#   - test_suite/ (pytest test files)

FROM python:3.12-slim

WORKDIR /app

# Install prd-bench-local-runner (provides prd_bench_local_runner.testing) and test deps
COPY prd-bench-local-runner/ /app/prd-bench-local-runner/
RUN pip install --no-cache-dir /app/prd-bench-local-runner/ pytest pytest-timeout requests

# Copy task-specific test code
COPY test_helpers/ /app/test_helpers/
COPY test_suite/ /app/test_suite/

# Output directory for results
RUN mkdir -p /app/output

# API_BASE_URL is set at runtime via docker run -e
ENV API_BASE_URL=
ENV PYTHONPATH=/app

CMD ["python", "-m", "pytest", "/app/test_suite/", \
     "--junitxml=/app/output/results.xml", \
     "-v", "--tb=short", "--timeout=10"]
