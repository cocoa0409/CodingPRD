 {
  "name": "perimeter_limited_service_assessment_lands_on_a_half_cent_and_rounds_up",
  "grounds": [
   "calculations.assessment_amount.precision",
   "calculations.assessment_amount.constants.ZONE_RATE",
   "calculations.assessment_amount.constants.CLASS_MULTIPLIER",
   "calculations.assessment_amount.constants.PER_NIGHT_FLOOR_CENTS"
  ],
  "setup": [
   "canonical district, but b3 is revised to LIMITED_SERVICE before the period is opened, so both the live values and the period-start snapshot read ZONE_PERIMETER / LIMITED_SERVICE",
   "period FY2027-Q1 generated, four statements"
  ],
  "setup_api_calls": [
   "@A1",
   "@A2",
   "@A3",
   "@A4",
   "@A5",
   "@A6",
   {
    "call": "POST /lodging-businesses/${b3_id}/revisions",
    "payload": {
     "classification": "LIMITED_SERVICE"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01"
   },
   "@A7",
   "@A8",
   "@A9",
   "@A10",
   "@A11",
   "@A12",
   "@A13",
   {
    "call": "GET /assessment-periods/${ap_id}/statements",
    "payload": {
     "lodging_business_id": "${b3_id}"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01",
    "captures": {
     "st3_id": "$.data[0].id"
    }
   }
  ],
  "trigger": [
   {
    "call": "POST /assessment-statements/${st3_id}/filings",
    "payload": {
     "reported_room_nights": 100,
     "reported_gross_room_revenue_cents": 1600800
    },
    "as": "LodgingOperator",
    "as_user_id": "${b3_id}"
   }
  ],
  "assert": [
   "the response status is 201",
   "AssessmentStatement.${st3_id}.zone_at_period_start == ZONE_PERIMETER",
   "AssessmentStatement.${st3_id}.classification_at_period_start == LIMITED_SERVICE",
   "AssessmentStatement.${st3_id}.provisional_assessment_cents == 17009",
   "AssessmentStatement.${st3_id}.provisional_assessment_cents != 17008, so truncation and round-half-even are both excluded",
   "AssessmentStatement.${st3_id}.effective_assessment_cents == 17009 and total_due_cents == 17009",
   "the 15000 per-night floor did not bind, since 17009 > 100 * 150"
  ]
 },
 {
  "name": "generation_skips_the_exempt_property_then_backfills_it_and_refuses_a_third_run",
  "grounds": [
   "endpoints.POST_/assessment-periods/{id}/statement-generation",
   "calculations.assessment_amount.input_set",
   "validations.p80_one_statement_per_period_and_business",
   "errors[ERR_STATEMENT_ALREADY_EXISTS_FOR_PERIOD]"
  ],
  "setup": [
   "canonical district ACTIVE with the four-property roll and period FY2027-Q1 open",
   "b4 revised to exempt_status GOVERNMENT_OWNED, so its status re-resolves to EXEMPT"
  ],
  "setup_api_calls": [
   "@A1",
   "@A2",
   "@A3",
   "@A4",
   "@A5",
   "@A6",
   "@A7",
   "@A8",
   "@A9",
   "@A10",
   "@A11",
   "@A12",
   {
    "call": "POST /lodging-businesses/${b4_id}/revisions",
    "payload": {
     "exempt_status": "GOVERNMENT_OWNED"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01"
   }
  ],
  "trigger": [
   {
    "call": "POST /assessment-periods/${ap_id}/statement-generation",
    "payload": {},
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01",
    "captures": {
     "run1_generated": "$.data.generated_count",
     "run1_skipped": "$.data.skipped_count"
    }
   },
   {
    "call": "POST /lodging-businesses/${b4_id}/revisions",
    "payload": {
     "exempt_status": "NONE"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01"
   },
   {
    "call": "POST /assessment-periods/${ap_id}/statement-generation",
    "payload": {},
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01",
    "captures": {
     "run2_generated": "$.data.generated_count",
     "run2_skipped": "$.data.skipped_count"
    }
   },
   {
    "call": "POST /assessment-periods/${ap_id}/statement-generation",
    "payload": {},
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01"
   }
  ],
  "assert": [
   "LodgingBusiness.${b4_id}.status == EXEMPT immediately after the exemption revision, and District.${d_id}.assessable_basis_cents == 95000000 with assessable_business_count == 3",
   "the first run returns 200 with generated_count == 3 and skipped_count == 1 and 3 entries in statement_ids",
   "AssessmentPeriod.${ap_id}.statement_count == 3 after the first run",
   "LodgingBusiness.${b4_id}.status == ASSESSABLE after the second revision, and District.${d_id}.assessable_basis_cents == 100000000 with assessable_business_count == 4",
   "the second run returns 200 with generated_count == 1 and skipped_count == 3 and 1 entry in statement_ids",
   "AssessmentPeriod.${ap_id}.statement_count == 4 after the second run",
   "GET /assessment-periods/${ap_id}/statements filtered to b4 returns exactly one row, with zone_at_period_start ZONE_PERIMETER, classification_at_period_start SHORT_TERM_RENTAL and assessment_method_at_period_start PCT_OF_ROOM_REVENUE",
   "the third run returns 409 with data.error_id == ERR_STATEMENT_ALREADY_EXISTS_FOR_PERIOD",
   "AssessmentPeriod.${ap_id}.statement_count is still 4 after the refused third run"
  ]
 },
 {
  "name": "plan_rollups_sit_exactly_on_the_admin_and_contingency_caps_at_approval",
  "grounds": [
   "calculations.work_plan_compliance.category_caps",
   "calculations.work_plan_compliance.funding_ratio",
   "entities.AnnualWorkPlan.fields.total_budget_cents",
   "entities.AnnualWorkPlan.fields.assessment_revenue_forecast_cents"
