   "entities.MarketingProgram.fields.status",
   "entities.MarketingProgram.fields.spend_frozen",
   "entities.MarketingProgram.fields.efficiency_tier",
   "entities.MarketingProgram.fields.performance_flag",
   "entities.AnnualWorkPlan.fields.committed_program_cents"
  ],
  "setup": [
   "district ACTIVE, st1 and st2 filed so the FY2027 forecast is 1,164,500",
   "plan FY2027 total 1,000,000 sponsored by board-member-01 and APPROVED by board-member-02"
  ],
  "setup_api_calls": [
   "@A1",
   "@A2",
   "@A3",
   "@A4",
   "@A5",
   "@A6",
   "@A7",
   "@A8",
   "@A9",
   "@A10",
   "@A11",
   "@A12",
   "@A13",
   "@A14",
   "@A15",
   "@A16",
   "@A17",
   "@A18",
   "@A19",
   "@A20"
  ],
  "trigger": [
   {
    "call": "POST /marketing-programs",
    "payload": {
     "annual_work_plan_id": "${wp_id}",
     "name": "Autumn Group Sales Push",
     "channel": "GROUP_SALES",
     "committed_cents": 62000,
     "lodging_tax_matched_cents": 0,
