 {
  "name": "dispute_creation_stamps_its_system_fields_and_copies_the_business_id",
  "grounds": [
   "entities.AssessmentDispute.fields.lodging_business_id",
   "entities.AssessmentDispute.fields.filed_on",
   "entities.AssessmentDispute.fields.status",
   "entities.AssessmentDispute.fields.granted_adjustment_cents",
   "entities.AssessmentDispute.fields.appeal_count",
   "endpoints.POST_/assessment-disputes"
  ],
  "setup": [
   "district ACTIVE, FY2027-Q1 open, st1 filed 2000 nights / 41,225,000 cents -> 824,500",
   "logical clock 2026-08-01T00:00:00Z"
  ],
  "setup_api_calls": [
   "@A1",
   "@A2",
   "@A3",
   "@A4",
   "@A5",
   "@A6",
   "@A7",
   "@A8",
   "@A9",
   "@A10",
   "@A11",
   "@A12",
   "@A13",
   "@A14",
   "@A15"
  ],
  "trigger": [
   {
    "call": "POST /assessment-disputes",
    "payload": {
     "assessment_statement_id": "${st1_id}",
     "dispute_type": "CALCULATION_ERROR",
     "claimed_adjustment_cents": 82450,
     "dispute_note": "resort fee should not sit in the revenue basis"
    },
    "as": "LodgingOperator",
    "as_user_id": "${b1_id}",
    "captures": {
     "dsp_id": "$.data.id"
    }
   }
  ],
  "assert": [
   "the response status is 201",
   "AssessmentDispute.${dsp_id}.lodging_business_id == ${b1_id}",
   "AssessmentDispute.${dsp_id}.assessment_statement_id == ${st1_id}",
   "AssessmentDispute.${dsp_id}.filed_on == 2026-08-01T00:00:00Z",
   "AssessmentDispute.${dsp_id}.status == SUBMITTED",
   "AssessmentDispute.${dsp_id}.claimed_adjustment_cents == 82450",
   "AssessmentDispute.${dsp_id}.granted_adjustment_cents == 0",
   "AssessmentDispute.${dsp_id}.appeal_count == 0",
   "AssessmentDispute.${dsp_id}.resolved_by_user_id == null and resolution_note == null",
   "AssessmentDispute.${dsp_id}.version == 1",
   "AssessmentStatement.${st1_id}.effective_assessment_cents is still 824500"
  ]
 },
 {
  "name": "creation_endpoints_reject_undeclared_enums_negative_cents_and_inverted_intervals",
  "grounds": [
   "entities.District.fields.assessment_method",
   "entities.District.fields.included_zones",
   "entities.LodgingBusiness.fields.prior_year_gross_room_revenue_cents",
   "entities.AssessmentPeriod.fields.period_start",
   "validations.priority_30_ERR_INVALID_REQUEST",
   "errors[ERR_INVALID_REQUEST]"
  ],
  "setup": [
   "logical clock 2026-08-01T00:00:00Z; canonical district exists"
  ],
  "setup_api_calls": [
   "@A1",
   "@A2"
  ],
  "trigger": [
   {
    "call": "POST /districts",
    "payload": {
     "name": "Bad Method District",
     "assessment_method": "FLAT_FEE_PER_ROOM"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01"
   },
   {
    "call": "POST /districts",
    "payload": {
     "name": "Duplicate Zone District",
     "included_zones": [
      "ZONE_CORE",
      "ZONE_CORE"
     ]
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01"
   },
   {
    "call": "POST /lodging-businesses",
    "payload": {
     "district_id": "${d_id}",
     "legal_name": "Negative Revenue Inn",
     "boundary_zone": "ZONE_CORE",
     "classification": "LIMITED_SERVICE",
     "room_count": 10,
     "prior_year_gross_room_revenue_cents": -1,
     "operator_contact_email": "ops@negative.example"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01"
   },
   {
    "call": "POST /assessment-periods",
    "payload": {
     "district_id": "${d_id}",
     "period_label": "FY2027-BAD",
     "period_start": "2026-11-01T00:00:00Z",
     "period_end": "2026-11-01T00:00:00Z",
     "due_date": "2026-11-15T00:00:00Z"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01"
   }
  ],
  "assert": [
   "all four responses have status 400 with data.error_id == ERR_INVALID_REQUEST",
   "no District row named Bad Method District or Duplicate Zone District exists",
   "District.${d_id}.assessable_business_count == 0, so the negative-revenue property was not created",
   "GET /districts/${d_id}/assessment-periods returns total_count == 0"
  ]
 },
