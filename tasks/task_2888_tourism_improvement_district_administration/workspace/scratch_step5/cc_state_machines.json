   },
   {
    "call": "POST /annual-work-plans/${wp_id}/board-actions",
    "payload": {
     "action": "CLOSE",
     "note": "closing the fiscal 2027 plan now that every program is terminal"
    },
    "as": "BoardMember",
    "as_user_id": "board-member-01"
   }
  ],
  "assert": [
   "the first CLOSE returns 409 with data.error_id == ERR_INVALID_STATE_TRANSITION",
   "AnnualWorkPlan.${wp_id}.status is still APPROVED after the first CLOSE",
   "the program closure returns 200 and MarketingProgram.${mp_id}.status == CLOSED",
   "MarketingProgram.${mp_id}.verified_room_nights == 100",
   "MarketingProgram.${mp_id}.gross_cost_per_room_night_cents == 620",
   "MarketingProgram.${mp_id}.efficiency_tier == TIER_EFFICIENT",
   "MarketingProgram.${mp_id}.dmo_cost_share_cents == 24800",
   "MarketingProgram.${mp_id}.net_district_cost_cents == 37200",
   "MarketingProgram.${mp_id}.net_cost_per_room_night_cents == 372",
   "MarketingProgram.${mp_id}.performance_index == 6.7204",
   "MarketingProgram.${mp_id}.performance_flag == MEETS_BENCHMARK",
   "MarketingProgram.${mp_id}.closed_at == 2026-09-25T00:00:00Z",
   "the second CLOSE returns 200 and AnnualWorkPlan.${wp_id}.status == CLOSED"
  ]
 }
