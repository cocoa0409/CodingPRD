[
 {
  "name": "district_moves_formed_to_active_without_restamping_its_term_dates",
  "grounds": [
   "state_machines.District.FORMED_to_ACTIVE",
   "endpoints.POST_/districts/{id}/lifecycle-advances",
   "entities.District.fields.formed_on",
   "entities.District.fields.expiration_date"
  ],
  "setup": [
   "canonical district with the four-property roll",
   "FORMATION drive CERTIFIED, so the district stands FORMED with its term dates stamped",
   "logical clock 2026-08-01T00:00:00Z"
  ],
  "setup_api_calls": [
   "@A1",
   "@A2",
   "@A3",
   "@A4",
   "@A5",
   "@A6",
   "@A7",
   "@A8",
   "@A9",
   "@A10",
   {
    "call": "GET /districts/${d_id}",
    "payload": {},
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01",
    "captures": {
     "d_v_formed": "$.data.version"
    }
   }
  ],
  "trigger": [
   {
    "call": "POST /districts/${d_id}/lifecycle-advances",
    "payload": {
     "to_status": "ACTIVE",
     "effective_on": "2026-08-01T00:00:00Z",
     "reason": "board resolution 2026-14"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01"
   }
  ],
  "assert": [
   "the response status is 200",
   "District.${d_id}.status == ACTIVE",
   "District.${d_id}.formed_on == 2026-08-01T00:00:00Z",
   "District.${d_id}.expiration_date == 2027-08-01T00:00:00Z",
   "District.${d_id}.version == ${d_v_formed} + 1",
   "PetitionDrive.${pd_id}.status is still CERTIFIED",
   "District.${d_id}.assessable_business_count == 4"
  ]
 },
 {
  "name": "activation_is_refused_once_the_assessable_roll_falls_below_the_petition_pool",
  "grounds": [
   "state_machines.District.FORMED_to_ACTIVE",
   "state_machines.LodgingBusiness.ASSESSABLE_to_CLOSED_OUT",
   "calculations.petition_support.constants.MIN_PETITION_POOL",
   "errors[ERR_INVALID_STATE_TRANSITION]"
  ],
  "setup": [
   "canonical district FORMED with its FORMATION drive CERTIFIED",
   "b2 and b3 closed out after certification, leaving 2 assessable properties"
  ],
  "setup_api_calls": [
   "@A1",
   "@A2",
   "@A3",
   "@A4",
   "@A5",
   "@A6",
   "@A7",
   "@A8",
   "@A9",
   "@A10",
   {
    "call": "POST /lodging-businesses/${b2_id}/revisions",
    "payload": {
     "close_out": true
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01"
   },
   {
    "call": "POST /lodging-businesses/${b3_id}/revisions",
    "payload": {
     "close_out": true
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01"
   }
  ],
  "trigger": [
   {
    "call": "POST /districts/${d_id}/lifecycle-advances",
    "payload": {
     "to_status": "ACTIVE",
     "effective_on": "2026-08-01T00:00:00Z"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01"
   }
  ],
  "assert": [
   "the response status is 409",
   "data.error_id == ERR_INVALID_STATE_TRANSITION",
   "District.${d_id}.status is still FORMED",
   "District.${d_id}.assessable_business_count == 2",
   "District.${d_id}.assessable_basis_cents == 65000000",
   "LodgingBusiness.${b2_id}.status == CLOSED_OUT and LodgingBusiness.${b3_id}.status == CLOSED_OUT",
   "PetitionDrive.${pd_id}.status is still CERTIFIED"
  ]
 },
 {
  "name": "boundary_revision_executes_every_declared_side_effect_in_one_call",
  "grounds": [
   "endpoints.POST_/districts/{id}/boundary-revisions",
   "state_machines.LodgingBusiness.ASSESSABLE_to_OUTSIDE_BOUNDARY",
   "state_machines.PetitionSignature.VALID_to_DISQUALIFIED",
   "calculations.petition_support",
   "entities.PetitionSignature.fields.disqualification_reason"
  ],
  "setup": [
   "canonical district with the four-property roll and an OPEN FORMATION drive",
   "b1 (ZONE_CORE) and b3 (ZONE_PERIMETER) have both signed",
   "logical clock 2026-08-01T00:00:00Z, inside the drive window"
  ],
  "setup_api_calls": [
   "@A1",
   "@A2",
   "@A3",
   "@A4",
   "@A5",
   "@A6",
   "@A7",
   "@A8",
   {
    "call": "POST /petition-drives/${pd_id}/signatures",
    "payload": {
     "lodging_business_id": "${b3_id}"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01",
    "captures": {
     "sig_b3_rev_id": "$.data.id"
    }
   },
   {
    "call": "GET /districts/${d_id}",
    "payload": {},
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01",
    "captures": {
     "d_v_pre_revision": "$.data.version"
    }
   }
  ],
  "trigger": [
   {
    "call": "POST /districts/${d_id}/boundary-revisions",
    "payload": {
     "included_zones": [
      "ZONE_CORE"
     ],
     "effective_on": "2026-08-05T00:00:00Z"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01"
   }
  ],
  "assert": [
   "the response status is 200",
   "District.${d_id}.included_zones == [ZONE_CORE]",
   "LodgingBusiness.${b3_id}.status == OUTSIDE_BOUNDARY and LodgingBusiness.${b4_id}.status == OUTSIDE_BOUNDARY",
   "LodgingBusiness.${b1_id}.status is still ASSESSABLE and LodgingBusiness.${b2_id}.status is still ASSESSABLE",
   "PetitionSignature.${sig_b3_rev_id}.status == DISQUALIFIED",
   "PetitionSignature.${sig_b3_rev_id}.disqualification_reason == OUTSIDE_BOUNDARY",
   "PetitionSignature.${sig_b1_id}.status is still VALID",
   "PetitionDrive.${pd_id}.signed_basis_cents == 60000000",
   "PetitionDrive.${pd_id}.valid_signature_count == 1",
   "PetitionDrive.${pd_id}.assessable_basis_snapshot_cents == 80000000",
   "PetitionDrive.${pd_id}.assessable_count_snapshot == 2",
   "PetitionDrive.${pd_id}.weighted_support_pct == 0.7500",
   "District.${d_id}.assessable_basis_cents == 80000000 and assessable_business_count == 2",
   "District.${d_id}.version == ${d_v_pre_revision} + 1"
  ]
 },
 {
  "name": "withdrawing_a_dispute_already_under_review_is_an_undeclared_transition",
  "grounds": [
   "state_machines.AssessmentDispute.SUBMITTED_to_WITHDRAWN",
   "state_machines.AssessmentDispute.SUBMITTED_to_UNDER_REVIEW",
   "errors[ERR_INVALID_STATE_TRANSITION]",
   "endpoints.POST_/assessment-disputes/{id}/proceedings"
  ],
  "setup": [
   "district ACTIVE, st1 filed 824,500",
   "a CALCULATION_ERROR dispute on st1 moved SUBMITTED -> UNDER_REVIEW by the hearing officer"
  ],
  "setup_api_calls": [
   "@A1",
   "@A2",
   "@A3",
   "@A4",
   "@A5",
   "@A6",
   "@A7",
   "@A8",
   "@A9",
   "@A10",
   "@A11",
   "@A12",
   "@A13",
   "@A14",
   "@A15",
   "@A28",
   "@A30"
  ],
  "trigger": [
   {
    "call": "POST /assessment-disputes/${dsp1_id}/proceedings",
    "payload": {
     "action": "WITHDRAW",
     "note": "operator wants to settle privately"
    },
    "as": "LodgingOperator",
    "as_user_id": "${b1_id}"
   }
  ],
  "assert": [
   "the response status is 409",
   "data.error_id == ERR_INVALID_STATE_TRANSITION",
   "AssessmentDispute.${dsp1_id}.status is still UNDER_REVIEW",
   "AssessmentDispute.${dsp1_id}.appeal_count == 0",
   "AssessmentDispute.${dsp1_id}.version == ${dsp1_v_under_review}",
   "AssessmentStatement.${st1_id}.effective_assessment_cents is still 824500"
  ]
 },
 {
  "name": "marketing_program_starts_planned_with_no_performance_figures_yet",
  "grounds": [
