   "AnnualWorkPlan.${wp_id}.total_budget_cents == 1000000",
   "AnnualWorkPlan.${wp_id}.administration_cents == 150000, exactly the 15 percent cap, and the approval is not refused",
   "AnnualWorkPlan.${wp_id}.contingency_reserve_cents == 100000, exactly the 10 percent cap, and the approval is not refused",
   "AnnualWorkPlan.${wp_id}.sales_and_marketing_cents == 650000, above the 600000 floor",
   "AnnualWorkPlan.${wp_id}.destination_events_cents == 100000 and capital_improvement_cents == 0",
   "AnnualWorkPlan.${wp_id}.assessment_revenue_forecast_cents == 1164500",
   "AnnualWorkPlan.${wp_id}.funding_ratio == 1.1645",
   "AnnualWorkPlan.${wp_id}.approver_user_id == board-member-02 and approved_at == 2026-08-01T00:00:00Z",
   "AnnualWorkPlan.${wp_id}.revision_count == 0 and committed_program_cents == 0"
  ]
 },
 {
  "name": "remittance_waterfall_fills_interest_then_penalty_then_principal_in_that_order",
