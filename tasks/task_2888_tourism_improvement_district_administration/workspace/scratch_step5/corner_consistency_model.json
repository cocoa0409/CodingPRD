[
 {
  "name": "the_filing_response_already_carries_every_derived_total",
  "claim_type": "immediate_visibility",
  "grounds": [
   "endpoints.POST_/assessment-statements/{id}/filings",
   "calculations.assessment_amount",
   "calculations.payment_status_derivation",
   "endpoints.GET_/districts/{id}/financial-summary"
  ],
  "distinguishing_aspect": "The filing response body is itself the authoritative view: provisional_assessment_cents,\neffective_assessment_cents, total_due_cents and version are all final in the 200 that the\nPOST returns, with no second request needed to settle them. Re-reading the row and the two\nderived-on-read rollups \u2014 the period's billed_total_cents and the public financial summary \u2014\nreturns byte-identical figures, which is what distinguishes immediate consistency from a\nmodel where the denormalised district and period totals would lag one request behind.\n",
  "test_recipe": {
   "setup": [
    "canonical district ACTIVE with FY2027-Q1 open and four statements generated NOT_FILED"
   ],
   "setup_api_calls": [
    {
     "call": "POST /_clock/set_current_utc",
     "payload": {
      "current_utc": "2026-08-01T00:00:00Z"
     },
     "as": "DistrictAdministrator",
     "as_user_id": "admin-01"
    },
    {
     "call": "POST /districts",
     "payload": {
      "name": "Harbor Bay Tourism Improvement District",
      "assessment_method": "PCT_OF_ROOM_REVENUE",
      "included_zones": [
       "ZONE_CORE",
       "ZONE_PERIMETER"
      ],
      "formation_threshold_pct": 0.6,
      "renewal_threshold_pct": 0.65,
      "renewal_headcount_threshold_pct": 0.75,
      "term_years": 1,
      "current_fiscal_year": 2027
     },
     "as": "DistrictAdministrator",
     "as_user_id": "admin-01",
     "captures": {
      "d_id": "$.data.id"
     }
    },
    {
     "call": "POST /lodging-businesses",
     "payload": {
      "district_id": "${d_id}",
      "legal_name": "Harbor Grand Hotel",
      "boundary_zone": "ZONE_CORE",
      "classification": "FULL_SERVICE",
      "room_count": 200,
      "prior_year_gross_room_revenue_cents": 60000000,
      "operator_contact_email": "ops@harborgrand.example"
     },
     "as": "DistrictAdministrator",
     "as_user_id": "admin-01",
     "captures": {
      "b1_id": "$.data.id"
     }
    },
    {
     "call": "POST /lodging-businesses",
     "payload": {
      "district_id": "${d_id}",
      "legal_name": "Bayside Inn",
      "boundary_zone": "ZONE_CORE",
      "classification": "LIMITED_SERVICE",
      "room_count": 120,
      "prior_year_gross_room_revenue_cents": 20000000,
      "operator_contact_email": "ops@baysideinn.example"
     },
     "as": "DistrictAdministrator",
     "as_user_id": "admin-01",
     "captures": {
      "b2_id": "$.data.id"
     }
    },
    {
     "call": "POST /lodging-businesses",
     "payload": {
      "district_id": "${d_id}",
      "legal_name": "Lighthouse Boutique",
      "boundary_zone": "ZONE_PERIMETER",
      "classification": "BOUTIQUE",
      "room_count": 60,
      "prior_year_gross_room_revenue_cents": 15000000,
      "operator_contact_email": "ops@lighthouse.example"
     },
     "as": "DistrictAdministrator",
     "as_user_id": "admin-01",
     "captures": {
      "b3_id": "$.data.id"
     }
    },
    {
     "call": "POST /lodging-businesses",
     "payload": {
      "district_id": "${d_id}",
      "legal_name": "Cove Cottages",
      "boundary_zone": "ZONE_PERIMETER",
      "classification": "SHORT_TERM_RENTAL",
      "room_count": 40,
      "prior_year_gross_room_revenue_cents": 5000000,
      "operator_contact_email": "ops@covecottages.example"
     },
     "as": "DistrictAdministrator",
     "as_user_id": "admin-01",
     "captures": {
      "b4_id": "$.data.id"
     }
    },
    {
     "call": "POST /petition-drives",
     "payload": {
      "district_id": "${d_id}",
      "drive_type": "FORMATION",
      "closes_at": "2026-09-01T00:00:00Z"
     },
     "as": "DistrictAdministrator",
     "as_user_id": "admin-01",
     "captures": {
      "pd_id": "$.data.id"
     }
    },
    {
     "call": "POST /petition-drives/${pd_id}/signatures",
     "payload": {
      "lodging_business_id": "${b1_id}"
     },
     "as": "DistrictAdministrator",
     "as_user_id": "admin-01",
     "captures": {
      "sig_b1_id": "$.data.id"
     }
    },
    {
     "call": "POST /petition-drives/${pd_id}/tally",
     "payload": {},
     "as": "DistrictAdministrator",
     "as_user_id": "admin-01"
    },
    {
     "call": "POST /petition-drives/${pd_id}/certification",
     "payload": {
      "certified_on": "2026-08-01T00:00:00Z"
     },
     "as": "DistrictAdministrator",
     "as_user_id": "admin-01"
    },
    {
     "call": "POST /districts/${d_id}/lifecycle-advances",
     "payload": {
      "to_status": "ACTIVE",
      "effective_on": "2026-08-01T00:00:00Z"
     },
     "as": "DistrictAdministrator",
     "as_user_id": "admin-01"
    },
    {
     "call": "POST /assessment-periods",
     "payload": {
      "district_id": "${d_id}",
      "period_label": "FY2027-Q1",
      "period_start": "2026-08-01T00:00:00Z",
      "period_end": "2026-11-01T00:00:00Z",
      "due_date": "2026-11-15T00:00:00Z",
      "grace_days": 10
     },
     "as": "DistrictAdministrator",
     "as_user_id": "admin-01",
     "captures": {
      "ap_id": "$.data.id"
     }
    },
    {
     "call": "POST /assessment-periods/${ap_id}/statement-generation",
     "payload": {},
     "as": "DistrictAdministrator",
     "as_user_id": "admin-01",
     "captures": {
      "gen_count": "$.data.generated_count"
     }
    },
    {
     "call": "GET /assessment-periods/${ap_id}/statements",
     "payload": {
      "lodging_business_id": "${b1_id}"
     },
     "as": "DistrictAdministrator",
     "as_user_id": "admin-01",
     "captures": {
      "st1_id": "$.data[0].id"
     }
    }
   ],
   "trigger": [
    {
     "call": "POST /assessment-statements/${st1_id}/filings",
     "payload": {
      "reported_room_nights": 2000,
      "reported_gross_room_revenue_cents": 41225000
     },
     "as": "LodgingOperator",
     "as_user_id": "${b1_id}",
     "captures": {
      "st1_v_filed": "$.data.version"
     }
    },
    {
     "call": "GET /assessment-statements/${st1_id}",
     "payload": {},
     "as": "DistrictAdministrator",
     "as_user_id": "admin-01"
    },
    {
     "call": "GET /assessment-periods/${ap_id}",
     "payload": {},
     "as": "DistrictAdministrator",
     "as_user_id": "admin-01"
    },
    {
     "call": "GET /districts/${d_id}/financial-summary",
     "payload": {
      "fiscal_year": 2027
     },
     "as": "PublicViewer"
    }
   ],
   "assert": [
    "the filing response itself already carries filing_status == FILED, filed_at == 2026-08-01T00:00:00Z, provisional_assessment_cents == 824500, effective_assessment_cents == 824500, total_due_cents == 824500 and version == 2",
    "the immediately following GET of the same statement returns exactly those seven values, with no field still null or stale",
    "GET /assessment-periods/${ap_id} returns billed_total_cents == 824500 and collected_total_cents == 0 on the first read after the filing",
    "GET /districts/${d_id}/financial-summary returns billed_total_cents == 824500, collected_to_date_cents == 0, statement_count == 4 and delinquent_statement_count == 0",
    "no repeated read changes any of these figures, since the whole recompute is inside the filing request"
   ]
  }
 },
 {
  "name": "a_remittance_reaches_the_district_ledger_inside_the_same_request",
  "claim_type": "immediate_visibility",
