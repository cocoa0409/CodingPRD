   "@A5",
   "@A6",
   "@A7",
   "@A8",
   "@A9",
   "@A10",
   "@A11",
   "@A12",
   "@A13",
   "@A14",
   "@A15",
   "@A16",
   "@A17",
   "@A18",
   "@A19"
  ],
  "trigger": [
   {
    "call": "POST /marketing-programs",
    "payload": {
     "annual_work_plan_id": "${wp_id}",
     "name": "Autumn Group Sales Push",
     "channel": "GROUP_SALES",
     "committed_cents": 62000,
     "lodging_tax_matched_cents": 0,
