   "MarketingProgram.${mp_id}.gross_cost_per_room_night_cents == null",
   "MarketingProgram.${mp_id}.net_cost_per_room_night_cents == null",
   "MarketingProgram.${mp_id}.efficiency_tier == null",
   "MarketingProgram.${mp_id}.performance_flag == NOT_MEASURED",
   "MarketingProgram.${mp_id}.performance_index == 0.0000",
   "MarketingProgram.${mp_id}.dmo_cost_share_cents == 0",
   "MarketingProgram.${mp_id}.launched_at == null and closed_at == null",
   "MarketingProgram.${mp_id}.version == 1",
   "AnnualWorkPlan.${wp_id}.committed_program_cents == 62000"
  ]
 },
 {
  "name": "certified_drive_and_verified_claim_both_refuse_any_further_action",
  "grounds": [
   "state_machines.PetitionDrive.terminal_states",
   "state_machines.RoomNightClaim.terminal_states",
   "errors[ERR_INVALID_STATE_TRANSITION]",
   "endpoints.POST_/petition-drives/{id}/tally",
   "endpoints.POST_/room-night-claims/{id}/verification"
  ],
  "setup": [
   "canonical district ACTIVE with its FORMATION drive CERTIFIED at weighted_support_pct 0.6000",
   "plan FY2027 APPROVED, DMO agreement EXECUTED, program RUNNING",
   "one room-night claim of 100 nights by b3, verified at 100 nights",
   "logical clock 2026-09-25T00:00:00Z"
  ],
  "setup_api_calls": [
   "@A1",
   "@A2",
   "@A3",
   "@A4",
   "@A5",
   "@A6",
   "@A7",
   "@A8",
   "@A9",
   "@A10",
   "@A11",
   "@A12",
   "@A13",
   "@A14",
   "@A15",
   "@A16",
   "@A17",
   "@A18",
   "@A19",
   "@A20",
   "@A23",
   "@A24",
   "@A25",
   "@A26",
   "@A27",
   "@A31",
   {
    "call": "POST /room-night-claims/${rnc_b3_id}/verification",
    "payload": {
     "decision": "ALLOW",
     "verified_room_nights": 100
    },
    "as": "DmoLiaison",
    "as_user_id": "dmo-01",
    "captures": {
     "rnc_b3_v_verified": "$.data.version"
    }
   }
  ],
  "trigger": [
   {
    "call": "POST /petition-drives/${pd_id}/tally",
    "payload": {},
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01"
   },
   {
    "call": "POST /room-night-claims/${rnc_b3_id}/verification",
    "payload": {
     "decision": "REJECT",
     "rejection_reason": "DUPLICATE_STAY"
    },
    "as": "DmoLiaison",
    "as_user_id": "dmo-01"
   }
  ],
  "assert": [
   "both responses have status 409 with data.error_id == ERR_INVALID_STATE_TRANSITION",
   "PetitionDrive.${pd_id}.status is still CERTIFIED",
   "PetitionDrive.${pd_id}.weighted_support_pct == 0.6000 and valid_signature_count == 1",
   "RoomNightClaim.${rnc_b3_id}.status is still VERIFIED",
   "RoomNightClaim.${rnc_b3_id}.verified_room_nights == 100",
   "RoomNightClaim.${rnc_b3_id}.rejection_reason == NONE",
   "RoomNightClaim.${rnc_b3_id}.version == ${rnc_b3_v_verified}"
  ]
 },
 {
  "name": "second_sponsor_action_and_second_period_closure_are_both_refused",
  "grounds": [
   "state_machines.AnnualWorkPlan.DRAFT_to_BOARD_REVIEW",
   "state_machines.AssessmentPeriod.OPEN_to_CLOSED",
   "errors[ERR_INVALID_STATE_TRANSITION]",
   "entities.AnnualWorkPlan.fields.sponsor_user_id"
  ],
  "setup": [
   "district ACTIVE, FY2027-Q1 with four generated statements, st1 filed 824,500 and the rest NOT_FILED",
   "plan FY2027 sponsored once by board-member-01, so it stands in BOARD_REVIEW"
  ],
  "setup_api_calls": [
   "@A1",
   "@A2",
   "@A3",
   "@A4",
   "@A5",
   "@A6",
   "@A7",
   "@A8",
   "@A9",
   "@A10",
   "@A11",
   "@A12",
   "@A13",
   "@A14",
   "@A15",
   "@A18",
   "@A19"
  ],
  "trigger": [
   {
    "call": "POST /annual-work-plans/${wp_id}/board-actions",
    "payload": {
     "action": "SPONSOR",
     "note": "sponsored again by a second board member"
    },
    "as": "BoardMember",
    "as_user_id": "board-member-03"
   },
   {
    "call": "POST /_clock/set_current_utc",
    "payload": {
     "current_utc": "2026-11-16T00:00:00Z"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01"
   },
   {
    "call": "POST /assessment-periods/${ap_id}/closure",
    "payload": {},
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01"
   },
   {
    "call": "POST /assessment-periods/${ap_id}/closure",
    "payload": {},
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01"
   }
  ],
  "assert": [
   "the second SPONSOR returns 409 with data.error_id == ERR_INVALID_STATE_TRANSITION",
   "AnnualWorkPlan.${wp_id}.status is still BOARD_REVIEW",
   "AnnualWorkPlan.${wp_id}.sponsor_user_id == board-member-01",
   "the first closure returns 200 and AssessmentPeriod.${ap_id}.status == CLOSED",
   "AssessmentPeriod.${ap_id}.statement_count == 4 and billed_total_cents == 824500 and collected_total_cents == 0",
   "the second closure returns 409 with data.error_id == ERR_INVALID_STATE_TRANSITION",
   "AssessmentPeriod.${ap_id}.status is still CLOSED and billed_total_cents is still 824500"
  ]
 },
 {
  "name": "disestablishment_cascades_down_into_planned_programs_and_open_drives",
  "grounds": [
   "state_machines.District.ACTIVE_to_DISESTABLISHED",
   "state_machines.PetitionDrive.OPEN_to_WITHDRAWN",
   "state_machines.MarketingProgram.PLANNED_to_CANCELLED",
   "endpoints.POST_/districts/{id}/lifecycle-advances"
  ],
  "setup": [
   "district ACTIVE with expiration_date 2027-08-01, plan FY2027 APPROVED, one PLANNED program",
   "period FY2027-Q1 already CLOSED, since the DISESTABLISHED precondition forbids an OPEN period",
   "logical clock 2027-03-01T00:00:00Z, inside the 180-day renewal window",
   "a RENEWAL petition drive OPEN with window [2027-03-01, 2027-06-01)"
  ],
  "setup_api_calls": [
   "@A1",
   "@A2",
   "@A3",
   "@A4",
   "@A5",
   "@A6",
   "@A7",
   "@A8",
   "@A9",
   "@A10",
   "@A11",
   "@A12",
   "@A13",
   "@A14",
   "@A15",
   "@A16",
   "@A17",
   "@A18",
   "@A19",
   "@A20",
   "@A24",
   "@A21",
   "@A22",
   {
    "call": "POST /_clock/set_current_utc",
    "payload": {
     "current_utc": "2027-03-01T00:00:00Z"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01"
   },
   {
    "call": "POST /petition-drives",
    "payload": {
     "district_id": "${d_id}",
     "drive_type": "RENEWAL",
     "closes_at": "2027-06-01T00:00:00Z"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01",
    "captures": {
     "rpd_id": "$.data.id"
    }
   }
  ],
  "trigger": [
   {
    "call": "POST /districts/${d_id}/lifecycle-advances",
    "payload": {
     "to_status": "DISESTABLISHED",
     "effective_on": "2027-03-01T00:00:00Z",
     "reason": "board voted to dissolve the district"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01"
   }
  ],
  "assert": [
   "the response status is 200",
   "District.${d_id}.status == DISESTABLISHED",
   "PetitionDrive.${rpd_id}.status == WITHDRAWN",
   "PetitionDrive.${pd_id}.status is still CERTIFIED, so the terminal formation drive is not touched",
   "MarketingProgram.${mp_id}.status == CANCELLED",
   "AnnualWorkPlan.${wp_id}.status is still APPROVED",
   "AssessmentPeriod.${ap_id}.status is still CLOSED and remains readable through GET /assessment-periods/${ap_id}, so the cascade did not reach it",
   "AssessmentStatement.${st1_id}.effective_assessment_cents is still 824500"
  ]
 },
