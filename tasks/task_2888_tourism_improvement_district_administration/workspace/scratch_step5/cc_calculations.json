   "@A5",
   "@A6",
   "@A7",
   "@A8",
   "@A9",
   "@A10",
   "@A11",
   "@A12",
   "@A13",
   "@A14",
   "@A15",
   "@A16",
   "@A17",
   "@A18",
   "@A19"
  ],
  "trigger": [
   {
    "call": "POST /annual-work-plans/${wp_id}/board-actions",
    "payload": {
