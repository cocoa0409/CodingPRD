[
 {
  "name": "district_creation_applies_every_declared_default",
  "grounds": [
   "entities.District.fields.assessment_method",
   "entities.District.fields.included_zones",
   "entities.District.fields.formation_threshold_pct",
   "entities.District.fields.renewal_threshold_pct",
   "entities.District.fields.renewal_headcount_threshold_pct",
   "entities.District.fields.term_years",
   "entities.District.fields.current_fiscal_year",
   "entities.District.fields.status",
   "endpoints.POST_/districts"
  ],
  "setup": [
   "empty database, logical clock pinned to 2026-08-01T00:00:00Z"
  ],
  "setup_api_calls": [
   "@A1"
  ],
  "trigger": [
   {
    "call": "POST /districts",
    "payload": {
     "name": "Default Bay Tourism Improvement District"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01",
    "captures": {
     "dflt_id": "$.data.id"
    }
   }
  ],
  "assert": [
   "the response status is 201",
   "District.${dflt_id}.assessment_method == PCT_OF_ROOM_REVENUE",
   "District.${dflt_id}.included_zones == [ZONE_CORE, ZONE_PERIMETER]",
   "District.${dflt_id}.formation_threshold_pct == 0.6000",
   "District.${dflt_id}.renewal_threshold_pct == 0.6500",
   "District.${dflt_id}.renewal_headcount_threshold_pct == 0.5000",
   "District.${dflt_id}.term_years == 5",
   "District.${dflt_id}.current_fiscal_year == 2027",
   "District.${dflt_id}.status == PROPOSED",
   "District.${dflt_id}.transparency_standing == COMPLIANT",
   "District.${dflt_id}.dmo_agreement_status == NONE",
   "District.${dflt_id}.dmo_name == null and District.${dflt_id}.formed_on == null and District.${dflt_id}.expiration_date == null",
   "District.${dflt_id}.collected_to_date_cents == 0 and delinquent_charges_cents == 0 and assessable_basis_cents == 0 and assessable_business_count == 0",
   "District.${dflt_id}.version == 1"
  ]
 },
 {
  "name": "lodging_business_creation_defaults_and_rolls_up_the_district_totals",
  "grounds": [
   "entities.LodgingBusiness.fields.exempt_status",
   "entities.LodgingBusiness.fields.remittance_frequency",
   "entities.LodgingBusiness.fields.status",
   "entities.LodgingBusiness.fields.compliance_standing",
   "entities.District.fields.assessable_basis_cents",
   "entities.District.fields.assessable_business_count",
   "endpoints.POST_/lodging-businesses"
  ],
  "setup": [
   "logical clock 2026-08-01T00:00:00Z",
   "canonical district created, still PROPOSED"
  ],
  "setup_api_calls": [
   "@A1",
   "@A2"
  ],
  "trigger": [
   {
    "call": "POST /lodging-businesses",
    "payload": {
     "district_id": "${d_id}",
     "legal_name": "Harbor Grand Hotel",
     "boundary_zone": "ZONE_CORE",
     "classification": "FULL_SERVICE",
     "room_count": 200,
     "prior_year_gross_room_revenue_cents": 60000000,
     "operator_contact_email": "ops@harborgrand.example"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01",
    "captures": {
     "b1_id": "$.data.id"
    }
   },
   {
    "call": "POST /lodging-businesses",
    "payload": {
     "district_id": "${d_id}",
     "legal_name": "Bayside Inn",
     "boundary_zone": "ZONE_CORE",
     "classification": "LIMITED_SERVICE",
     "room_count": 120,
     "prior_year_gross_room_revenue_cents": 20000000,
     "operator_contact_email": "ops@baysideinn.example"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01",
    "captures": {
     "b2_id": "$.data.id"
    }
   },
   {
    "call": "POST /lodging-businesses",
    "payload": {
     "district_id": "${d_id}",
     "legal_name": "Lighthouse Boutique",
     "boundary_zone": "ZONE_PERIMETER",
     "classification": "BOUTIQUE",
     "room_count": 60,
     "prior_year_gross_room_revenue_cents": 15000000,
     "operator_contact_email": "ops@lighthouse.example"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01",
    "captures": {
     "b3_id": "$.data.id"
    }
   },
   {
    "call": "POST /lodging-businesses",
    "payload": {
     "district_id": "${d_id}",
     "legal_name": "Cove Cottages",
     "boundary_zone": "ZONE_PERIMETER",
     "classification": "SHORT_TERM_RENTAL",
     "room_count": 40,
     "prior_year_gross_room_revenue_cents": 5000000,
     "operator_contact_email": "ops@covecottages.example"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01",
    "captures": {
     "b4_id": "$.data.id"
    }
   },
   {
    "call": "GET /districts/${d_id}",
    "payload": {},
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01"
   }
  ],
  "assert": [
   "each of the four create responses has status 201",
   "LodgingBusiness.${b4_id}.status == ASSESSABLE",
   "LodgingBusiness.${b4_id}.exempt_status == NONE",
   "LodgingBusiness.${b4_id}.remittance_frequency == MONTHLY",
   "LodgingBusiness.${b4_id}.delinquency_strike_count == 0",
   "LodgingBusiness.${b4_id}.compliance_standing == GOOD",
   "LodgingBusiness.${b4_id}.version == 1",
   "District.${d_id}.assessable_basis_cents == 100000000",
   "District.${d_id}.assessable_business_count == 4"
  ]
 },
 {
  "name": "public_district_retrieval_returns_the_stored_row_with_no_headers",
  "grounds": [
   "endpoints.GET_/districts/{id}",
   "roles.PublicViewer",
   "validations.priority_10_ERR_UNAUTHENTICATED"
  ],
  "setup": [
   "canonical district created with the four-property roll"
  ],
  "setup_api_calls": [
   "@A1",
   "@A2",
   "@A3",
   "@A4",
   "@A5",
   "@A6"
  ],
  "trigger": [
   {
    "call": "GET /districts/${d_id}",
    "payload": {},
    "as": "PublicViewer"
   }
  ],
  "assert": [
   "the response status is 200 and no ERR_UNAUTHENTICATED is returned",
   "District.${d_id}.name == Harbor Bay Tourism Improvement District",
   "District.${d_id}.assessment_method == PCT_OF_ROOM_REVENUE",
   "District.${d_id}.included_zones == [ZONE_CORE, ZONE_PERIMETER]",
   "District.${d_id}.formation_threshold_pct == 0.6000",
   "District.${d_id}.term_years == 1",
   "District.${d_id}.status == PROPOSED",
   "the envelope carries meta.api_request_id, meta.api_request_timestamp and response_type == object"
  ]
 },
 {
  "name": "lodging_business_listing_paginates_with_total_count_and_has_more",
  "grounds": [
   "endpoints.GET_/districts/{id}/lodging-businesses",
   "response_envelope.pagination_fields",
   "response_envelope.pagination_defaults"
  ],
  "setup": [
   "canonical district created with the four-property roll, created in b1, b2, b3, b4 order"
  ],
  "setup_api_calls": [
   "@A1",
   "@A2",
   "@A3",
   "@A4",
   "@A5",
   "@A6"
  ],
  "trigger": [
   {
    "call": "GET /districts/${d_id}/lodging-businesses",
    "payload": {
     "limit": 2,
     "offset": 0
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01",
    "captures": {
     "page1_first_id": "$.data[0].id"
    }
   },
   {
    "call": "GET /districts/${d_id}/lodging-businesses",
    "payload": {
     "limit": 2,
     "offset": 2
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01",
    "captures": {
     "page2_first_id": "$.data[0].id"
    }
   },
   {
    "call": "GET /districts/${d_id}/lodging-businesses",
    "payload": {
     "boundary_zone": "ZONE_PERIMETER"
    },
    "as": "DistrictAdministrator",
    "as_user_id": "admin-01",
    "captures": {
     "perimeter_first_id": "$.data[0].id"
    }
   }
  ],
  "assert": [
   "the limit 2 / offset 0 response carries exactly 2 rows, total_count == 4, limit == 2, offset == 0 and has_more == true",
   "the limit 2 / offset 2 response carries exactly 2 rows, total_count == 4, offset == 2 and has_more == false",
   "${page1_first_id} == ${b1_id} and ${page2_first_id} == ${b3_id}",
   "the boundary_zone ZONE_PERIMETER response carries total_count == 2, limit == 10, offset == 0 and has_more == false",
   "${perimeter_first_id} == ${b3_id}",
   "response_type == array on all three responses"
  ]
 },
 {
